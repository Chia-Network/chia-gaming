import types::*;

// Adjudicates a two-player turn-based game.
//
// The last move, INFOHASH_B, and MOVER_SHARE are accepted optimistically from the previous move.
//
// INFOHASH_A and INFOHASH_B are commitments: `sha256(validation_program_hash, tree_hash(state))`.
//
// To slash, the referee runs the previous validation program with its hash, followed by the
// referee's own arguments. The validator returns a `ValidatorResult`, or nil. Slashing succeeds in
// three cases:
//
// 1. The result is nil, which slashes unconditionally.
// 2. The result's next validator hash, new state, or maximum move size don't match this coin's
//    commitments, which also slashes unconditionally.
// 3. The result matches the commitments, but has extra conditions, which slashes conditionally.
//    The extra conditions come before the payout (such as an `AGG_SIG_UNSAFE` for a signed
//    dictionary range proof).
//
// If the result matches the commitments and has no extra conditions, the move was valid, and the
// slash fails.
//
// MOVER_SHARE is how much the mover gets if they fold or the timeout is claimed.
fn main(params: RefereeParameters, ...solution: RefereeSolution) -> List<Condition> {
    // A pair on the right identifies a Move. Its fields are checked in make_move.
    if solution is (Any, (Any, Any)) {
        return make_move(params, solution);
    }
    match solution {
        RefereeTimeout => timeout(params, solution),
        RefereeSlash => slash(params, solution),
    }
}

inline fn timeout(params: RefereeParameters, solution: RefereeTimeout) -> List<Condition> {
    let { coin, turn } = params;
    let { mover_payout_ph, waiter_payout_ph } = solution;
    let waiter_share = coin.amount - turn.mover_share;

    let waiter_payout = if waiter_share != 0 {
        signed_payout(waiter_payout_ph, waiter_share, coin.players.waiter_pubkey, nil)
    } else {
        assert (waiter_payout_ph as Bytes) is nil;
        nil
    };

    let payouts = if turn.mover_share != 0 {
        signed_payout(mover_payout_ph, turn.mover_share, coin.players.mover_pubkey, waiter_payout)
    } else {
        assert (mover_payout_ph as Bytes) is nil;
        [Remark {} as Condition, Remark {}, ...waiter_payout]
    };
    [AssertHeightRelative { height: coin.timeout }, ...payouts]
}

inline fn slash(params: RefereeParameters, solution: RefereeSlash) -> List<Condition> {
    let { coin, turn } = params;
    let { move, mover_payout_ph } = solution;
    let validator = move.validation_program;
    let validator_hash = tree_hash(validator);
    let result = validator(validator_hash, params, move, ...mover_payout_ph);

    let payout = signed_payout(mover_payout_ph, coin.amount, coin.players.mover_pubkey, nil);

    assert turn.infohash_a as Bytes == sha256(validator_hash + tree_hash(move.state));

    match result {
        nil => payout,
        ValidatorResult<Any> {
            transition: { next_validator_hash, new_state },
            max_move_size,
            extra_conditions,
        } => {
            // Hashing for a nil hash can't fail, so both branches are evaluated.
            let committed_infohash = inline if next_validator_hash is nil {
                nil
            } else {
                sha256(next_validator_hash as Bytes + tree_hash(new_state))
            };

            // Each check is evaluated, so a malformed result fails rather than slashing.
            let aligned = (committed_infohash == turn.infohash_b as Bytes)
                & (max_move_size == turn.last_move.max_move_size)
                & (inline if next_validator_hash is nil { max_move_size == 0 } else { true });

            if !aligned {
                return payout;
            }

            assert !(extra_conditions is nil);
            [...extra_conditions, ...payout]
        }
    }
}

// Pays the amount to the puzzle hash, which the public key signs, followed by the rest.
fn signed_payout(
    puzzle_hash: Bytes32,
    amount: Int,
    public_key: PublicKey,
    rest: List<Condition>,
) -> List<Condition> {
    [
        CreateCoin { puzzle_hash, amount },
        AggSigUnsafe { public_key, message: "x" + puzzle_hash },
        ...rest,
    ]
}

inline fn make_move(params: RefereeParameters, solution: RefereeMove) -> List<Condition> {
    let { coin, turn } = params;
    let { proposal: { new_move, infohash_c }, new_mover_share, new_max_move_size } = solution;

    // The next coin swaps the players, and commits to this move.
    let new_params = RefereeParameters {
        coin: RefereeCoin {
            ...coin,
            players: Players {
                mover_pubkey: coin.players.waiter_pubkey,
                waiter_pubkey: coin.players.mover_pubkey,
            },
        },
        turn: RefereeTurn {
            last_move: LastMove {
                nonce: turn.last_move.nonce,
                game_move: new_move,
                max_move_size: new_max_move_size,
            },
            infohash_b: infohash_c,
            mover_share: new_mover_share,
            infohash_a: turn.infohash_b,
        },
    };
    let new_puzzle_hash = curry_one_tree_hash(coin.mod_hash, tree_hash(new_params));

    // Every check is evaluated, which is smaller than an assert for each. Each one only fails or is
    // false where a separate assert would fail.
    assert (!(turn.infohash_b is nil))
        & (new_move.length <= turn.last_move.max_move_size)
        & (new_max_move_size.length <= 2)
        & (new_max_move_size >= 0)
        & (new_max_move_size == new_max_move_size + 0)
        & (new_mover_share <= coin.amount)
        & (new_mover_share >= 0)
        & (new_mover_share == new_mover_share + 0)
        & ((infohash_c is nil) | ((infohash_c as Bytes).length == 32))
        & (!(infohash_c is nil) | (new_max_move_size == 0));

    [
        AssertBeforeHeightRelative { height: coin.timeout },
        CreateCoin { puzzle_hash: new_puzzle_hash, amount: coin.amount },
        AggSigMe { public_key: coin.players.mover_pubkey, message: tree_hash(solution) },
    ]
}

// `curry_tree_hash(mod_hash, [argument_hash])`, for the referee's single curried argument: the hash
// of `(a (q . MOD) (c (q . ARGUMENT) 1))`.
fn curry_one_tree_hash(mod_hash: Bytes32, argument_hash: Bytes32) -> Bytes32 {
    let quote = tree_hash_atom(1 as Bytes);
    let nil_hash = tree_hash_atom(nil);
    let environment = tree_hash_pair(
        tree_hash_atom(4 as Bytes),
        tree_hash_pair(tree_hash_pair(quote, argument_hash), tree_hash_pair(quote, nil_hash)),
    );
    tree_hash_pair(
        tree_hash_atom(2 as Bytes),
        tree_hash_pair(tree_hash_pair(quote, mod_hash), tree_hash_pair(environment, nil_hash)),
    )
}
