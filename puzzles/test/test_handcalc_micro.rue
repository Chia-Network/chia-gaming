import project::games::calpoker::arrange::{final_cards, pull_out_cards};
import project::games::calpoker::handcalc::handcalc;

// Runs one of calpoker's card helpers, chosen by `kind`, for `src/tests/chialisp.rs`. The test
// passes the arguments that the helper expects.
fn main(kind: Bytes, ...arguments: Any) -> Any {
    if kind == "pull_out_cards" {
        let { selections, cards } = unchecked_cast::<PullOutCardsArgs>(arguments);
        pull_out_cards(selections, cards)
    } else if kind == "get_final_cards_in_canonical_order" {
        let {
            alice_cards,
            alice_discards,
            bob_cards,
            bob_discards,
        } = unchecked_cast::<FinalCardsArgs>(arguments);
        final_cards(alice_cards, alice_discards, bob_cards, bob_discards)
    } else if kind == "handcalc" {
        handcalc(unchecked_cast::<CardsArgs>(arguments).cards)
    } else {
        raise ["Couldn't find entrypoint: ", kind];
    }
}

struct CardsArgs {
    cards: List<Int>,
}

struct PullOutCardsArgs {
    selections: Int,
    cards: List<Int>,
}

struct FinalCardsArgs {
    alice_cards: List<Int>,
    alice_discards: Int,
    bob_cards: List<Int>,
    bob_discards: Int,
}
