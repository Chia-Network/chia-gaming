import cards::popcount;
import types::Hands;

// Each player's final eight cards, given each player's discards: the cards that a player keeps,
// and the cards that the other player discards to them, sorted.
export fn final_cards(
    alice_cards: List<Int>,
    alice_discards: Int,
    bob_cards: List<Int>,
    bob_discards: Int,
) -> Hands {
    let alice = split_cards(alice_discards, alice_cards, nil, nil);
    let bob = split_cards(bob_discards, bob_cards, nil, nil);
    Hands {
        alice_cards: sort([...alice.kept, ...bob.discarded]),
        bob_cards: sort([...bob.kept, ...alice.discarded]),
    }
}

// The cards that a player keeps, and the ones they discard, each in reverse order.
struct Split {
    kept: List<Int>,
    ...discarded: List<Int>,
}

// Splits the cards by a mask, whose lowest bit is for the first card. A set bit discards a card.
export fn split_cards(mask: Int, cards: List<Int>, kept: List<Int>, discarded: List<Int>) -> Split {
    if cards is nil {
        Split { kept, discarded }
    } else if mask & 1 != 0 {
        split_cards(mask >>> 1, cards.rest, kept, [cards.first, ...discarded])
    } else {
        split_cards(mask >>> 1, cards.rest, [cards.first, ...kept], discarded)
    }
}

// The cards that the selections pick, which must be five of them. The lowest bit of the selections
// is for the first card.
export fn pull_out_cards(selections: Int, cards: List<Int>) -> List<Int> {
    assert popcount(selections) == 5, "pull_out_cards got bad data";
    pick_cards(selections, cards)
}

fn pick_cards(selections: Int, cards: List<Int>) -> List<Int> {
    if cards is nil {
        return nil;
    }

    let picked = pick_cards(selections >>> 1, cards.rest);
    if selections & 1 != 0 {
        [cards.first, ...picked]
    } else {
        picked
    }
}

// Sorts the cards into ascending order, with a stable merge sort.
fn sort(cards: List<Int>) -> List<Int> {
    if cards is nil {
        return nil;
    }

    if cards.rest is nil {
        return cards;
    }

    let halves = split(cards, nil, nil);
    merge(sort(halves.kept), sort(halves.discarded), nil)
}

// Deals the cards into two halves, alternating between them.
fn split(cards: List<Int>, left: List<Int>, right: List<Int>) -> Split {
    if cards is nil {
        Split { kept: left, discarded: right }
    } else {
        split(cards.rest, right, [cards.first, ...left])
    }
}

// Merges two ascending lists, prepending what's merged so far (in reverse) to the rest.
fn merge(a: List<Int>, b: List<Int>, merged: List<Int>) -> List<Int> {
    if a is nil {
        prepend_reversed(merged, b)
    } else if b is nil {
        prepend_reversed(merged, a)
    } else if deep_compare(a.first, b.first) == -1 {
        merge(a.rest, b, [a.first, ...merged])
    } else {
        merge(a, b.rest, [b.first, ...merged])
    }
}

fn prepend_reversed(reversed: List<Int>, rest: List<Int>) -> List<Int> {
    [...reverse(reversed), ...rest]
}

// Compares two values of any shape, returning -1, 0, or 1. Atoms compare as numbers, and are
// less than pairs, which compare by their first and then their rest. Cards are compared this way
// so that a malformed card can't make sorting fail.
export fn deep_compare(a: Any, b: Any) -> Int {
    if a is (Any, Any) {
        if b is (Any, Any) {
            let first = deep_compare(a.first, b.first);
            if first != 0 {
                first
            } else {
                deep_compare(a.rest, b.rest)
            }
        } else {
            1
        }
    } else if b is (Any, Any) {
        -1
    } else if a as Int > b as Int {
        1
    } else if b as Int > a as Int {
        -1
    } else {
        0
    }
}
