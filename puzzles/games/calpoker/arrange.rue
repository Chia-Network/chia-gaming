import cards::popcount;
import hand::sort_into;
import types::Hands;

// Each player's final eight cards, given each player's discards: the cards that a player keeps,
// and the cards that the other player discards to them, sorted.
export fn final_cards(
    alice_cards: List<Int>,
    alice_discards: Int,
    bob_cards: List<Int>,
    bob_discards: Int,
) -> Hands {
    let alice = split_cards(alice_discards, alice_cards, nil, nil);
    let bob = split_cards(bob_discards, bob_cards, nil, nil);
    Hands {
        alice_cards: ascending_card_ids(alice.kept, bob.discarded),
        bob_cards: ascending_card_ids(bob.kept, alice.discarded),
    }
}

// The cards that a player keeps, and the ones they discard, each in reverse order.
struct Split {
    kept: List<Int>,
    ...discarded: List<Int>,
}

// Splits the cards by a mask, whose lowest bit is for the first card. A set bit discards a card.
fn split_cards(mask: Int, cards: List<Int>, kept: List<Int>, discarded: List<Int>) -> Split {
    if cards is nil {
        return Split { kept, discarded };
    }

    let discard = mask & 1 != 0;
    split_cards(
        mask >>> 1,
        cards.rest,
        inline if discard { kept } else { [cards.first, ...kept] },
        inline if discard { [cards.first, ...discarded] } else { discarded },
    )
}

// The cards that the selections pick, which must be five of them. The lowest bit of the selections
// is for the first card.
export fn pull_out_cards(selections: Int, cards: List<Int>) -> List<Int> {
    assert popcount(selections) == 5, "pull_out_cards got bad data";
    pick_cards(selections, cards)
}

export fn pick_cards(selections: Int, cards: List<Int>) -> List<Int> {
    if cards is nil {
        return nil;
    }

    let picked = pick_cards(selections >>> 1, cards.rest);
    inline if selections & 1 != 0 { [cards.first, ...picked] } else { picked }
}

// Selection bits index the card IDs in ascending order. This is `atomsort` of the kept cards
// followed by the received ones, reversed, without joining the lists first.
inline fn ascending_card_ids(kept: List<Int>, received: List<Int>) -> List<Int> {
    reverse(sort_into(kept, sort_into(received, nil)))
}

// Compare atoms as integers and pairs lexicographically, with atoms before pairs.
export fn deep_compare(a: Any, b: Any) -> Int {
    if a is (Any, Any) {
        if b is (Any, Any) {
            let first = deep_compare(a.first, b.first);
            if first != 0 {
                first
            } else {
                deep_compare(a.rest, b.rest)
            }
        } else {
            1
        }
    } else if b is (Any, Any) {
        -1
    } else if a as Int > b as Int {
        1
    } else if b as Int > a as Int {
        -1
    } else {
        0
    }
}
