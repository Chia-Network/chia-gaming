import project::referee::types::*;
import super::cards::make_cards;
import super::types::{Deal, Seeds};

// Alice reveals her seed, and commits to her discards. The move is the 16 byte seed, followed by
// the 32 byte commitment. The cards are dealt from both seeds and the amount.
export fn main(
    _validator_hash: Bytes32,
    params: RefereeParameters,
    move: ValidatorMove<Seeds, nil>,
    ..._payout: Bytes32 | nil,
) -> ValidatorResult<Deal> | nil {
    let game_move = params.turn.last_move.game_move;
    if game_move.length != 48 {
        return nil;
    }

    let alice_seed = game_move[..16];
    let { seed_commit, bob_seed } = move.state;
    let hands = make_cards(sha256(alice_seed + bob_seed + params.coin.amount as Bytes) as Int);
    let deal = Deal { discard_commit: game_move[16..48], hands };

    // The deal is evaluated even if the seed doesn't match, so a malformed seed or amount fails
    // either way.
    inline if sha256(alice_seed) == seed_commit {
        validator_transition(const { tree_hash(d::main) }, deal, 1)
    } else {
        nil
    }
}
