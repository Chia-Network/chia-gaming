import project::games::spacepoker::states::*;
import project::referee::types::*;

// The mover responds to a raise by raising again, or calls by revealing the preimage of their
// image of this round. A raise is longer than 32 bytes, and anything after the first 32 bytes is
// the amount. The preimage is 32 bytes, except at round 1, where it's the 16 byte preimage of the
// whole chain.
//
// The waiter's image in the state is the image of the player who raised last, from their own
// view. Each move swaps the mover and the waiter, so this validator reads the images the other
// way around from `begin_round`, and swaps them back when it returns to it.
//
// There's no evidence.
export fn main(
    validator_hash: Bytes32,
    params: RefereeParameters,
    move: ValidatorMove<RaiseState, nil>,
    ..._payout: Bytes32 | nil,
) -> ValidatorResult<SpaceState> | nil {
    let game_move = params.turn.last_move.game_move;

    if game_move.length > 32 {
        // The previous raise goes into the pot for both players.
        let raise_amount = game_move[32..] as Int;
        let half_pot = move.state.stakes.half_pot + move.state.stakes.last_raise;
        let half_amount = params.coin.amount / 2;
        if !(
            params.turn.mover_share == half_amount
                    - half_pot
                && raise_amount >= 0
                && half_pot
                        + raise_amount
                    <= half_amount
        ) {
            return nil;
        }

        return validator_transition(
            validator_hash,
            RaiseState {
                stakes: RaiseStakes { ...move.state.stakes, half_pot, last_raise: raise_amount },
                street: RaiseStreet {
                    ...move.state.street,
                    mover_image: move.state.street.waiter_image,
                    waiter_image: move.state.street.mover_image,
                },
            },
            42,
        );
    }

    let round = move.state.street.round;
    if !(
        game_move.length == (inline if round == 1 { 16 } else { 32 })
            && sha256(game_move) == move.state.street.mover_image
    ) {
        return nil;
    }

    let half_pot = move.state.stakes.half_pot + move.state.stakes.last_raise;
    if params.turn.mover_share != params.coin.amount / 2 - half_pot {
        return nil;
    }

    if round == 1 {
        validator_transition(
            const { tree_hash(end::main) },
            EndState {
                half_pot,
                mover_image: move.state.street.waiter_image,
                waiter_preimage: game_move,
            },
            17,
        )
    } else {
        validator_transition(
            const { tree_hash(begin_round::main) },
            OpenState {
                stakes: OpenStakes {
                    bet_unit: move.state.stakes.bet_unit,
                    half_pot,
                    mover_image: move.state.street.waiter_image,
                },
                street: OpenStreet {
                    waiter_image: game_move,
                    round: round - 1,
                    mid_hash: validator_hash,
                },
            },
            42,
        )
    }
}
