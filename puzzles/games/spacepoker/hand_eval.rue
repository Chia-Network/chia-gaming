import project::games::poker::{atomsort, group_ranks};

// Ranks a five-card Space Poker hand, so that comparing two rankings with `deep_compare` compares
// the hands. There are no flushes, and an ace is only high.
//
// A ranking is the counts of each rank in the hand, highest first, then the boost, then the ranks
// in the same order. A straight beats a full house, since straights are rarer without suits:
//
// | Hand            | Ranking                        |
// | --------------- | ------------------------------ |
// | Five of a kind  | `5 boost rank`                 |
// | Four of a kind  | `4 1 boost quad kicker`        |
// | Straight        | `3 3 boost high`               |
// | Full house      | `3 2 boost set pair`           |
// | Three of a kind | `3 1 1 boost set k1 k2`        |
// | Two pair        | `2 2 1 boost high low kicker`  |
// | Pair            | `2 1 1 1 boost pair k1 k2 k3`  |
// | High card       | `1 1 1 1 1 boost h k1 k2 k3 k4` |
export fn space_hand_eval(cards: List<Int>, boost: Bool) -> List<Int> {
    let ranks = atomsort(cards);
    // The hand selection supplies five ranks, and atomsort preserves their count.
    let ranks = unchecked_cast::<[Int, Int, Int, Int, Int, ...List<Int>]>(ranks);
    let [high, second, third, fourth, low, ..._] = ranks;
    if (high != second) & (second != third) & (third != fourth) & (fourth != low) {
        return inline if high - low == 4 {
            [3, 3, boost as Int, high]
        } else {
            [1, 1, 1, 1, 1, boost as Int, ...ranks]
        };
    }

    let groups = atomsort(group_ranks(ranks.rest, high, 1));
    [...for group in groups { group >>> 4 }, boost as Int, ...for group in groups { group & 15 }]
}

// Compares two rankings from `space_hand_eval` like `deep_compare`. Rankings with the same counts
// have the same length, and no list of counts is the start of another, so the rankings differ
// before either of them ends, or they're the same length.
export fn compare_rankings(left: List<Int>, right: List<Int>) -> Int {
    if left is nil {
        return 0;
    }
    assert right is (Int, List<Int>);
    if left.first != right.first {
        inline if left.first > right.first { 1 } else { -1 }
    } else {
        compare_rankings(left.rest, right.rest)
    }
}
