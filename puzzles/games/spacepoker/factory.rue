import handlers::*;
import project::games::poker::deep_compare;
import project::games::types::*;

// The arguments of the factory: both players' reserves, and the game parameters that the
// proposal converts from Bencodex.
export struct FactoryArgs {
    proposer_reserve: Int,
    accepter_reserve: Int,
    parameters: SpaceParameters,
}

// The stack of each player, in bet units, and the bet unit, which is the minimum raise. A stack of
// zero selects the largest stack that both reserves allow. The readable parameters of the game are
// the same, with the stack that was selected.
export struct SpaceParameters {
    stack_size: Int,
    minimum_raise: Int,
}

type SpaceFactoryResult = FactoryResult<Int, SpaceParameters, SpaceMyTurn, SpaceTheirTurn>;

// Creates one game, where both players put in the same stake, and Alice (the proposer) goes first.
fn main(...args: FactoryArgs) -> SpaceFactoryResult {
    let { proposer_reserve, accepter_reserve, parameters: { stack_size, minimum_raise } } = args;
    assert stack_size >= 0;
    assert minimum_raise > 0;
    assert minimum_raise == minimum_raise + 0;
    // There's nothing else in the arguments.
    assert deep_compare(
        args,
        [proposer_reserve, accepter_reserve, [stack_size, minimum_raise]],
    ) == 0;

    let stake = if stack_size != 0 {
        stack_size * minimum_raise
    } else {
        let smaller_reserve = inline if proposer_reserve < accepter_reserve {
            proposer_reserve
        } else {
            accepter_reserve
        };
        smaller_reserve / minimum_raise * minimum_raise
    };

    if stake == 0 || stake > proposer_reserve || stake > accepter_reserve {
        return FactoryShort {
            proposer_short: inline if stack_size != 0 {
                stake > proposer_reserve
            } else {
                proposer_reserve < minimum_raise
            },
            accepter_short: inline if stack_size != 0 {
                stake > accepter_reserve
            } else {
                accepter_reserve < minimum_raise
            },
        };
    }

    FactorySuccess::<Int, SpaceParameters, SpaceMyTurn, SpaceTheirTurn> {
        records: [GameRecord::<Int, SpaceParameters, SpaceMyTurn, SpaceTheirTurn> {
            proposer_contribution: stake,
            accepter_contribution: stake,
            proposer_goes_first: true,
            initial_move: nil,
            initial_max_move_size: 32,
            initial_state: minimum_raise,
            initial_mover_share: 0,
            my_turn_handler: alice_commit_a,
            their_turn_handler: bob_commit_a_their,
            validation_programs: [
                as_validator(onchain::commitA::main),
                as_validator(onchain::commitB::main),
                as_validator(onchain::begin_round::main),
                as_validator(onchain::mid_round::main),
                as_validator(onchain::end::main),
            ],
            readable_parameters: SpaceParameters {
                stack_size: stake / minimum_raise,
                minimum_raise,
            },
        }],
    }
}
