{
  "name": "chia-gaming-hub-service",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm exec tsc --project . && pnpm exec esbuild dist/index.js --platform=node --bundle --outfile=dist/index-rollup.cjs",
    "start": "node dist/index-rollup.cjs",
    "dev": "tsx watch src/index.ts",
    "test": "pnpm run build && node --test src/*.test.mjs"
  },
  "dependencies": {
    "chia-gaming-bencodex": "workspace:*",
    "chia-gaming-protocol-constants": "workspace:*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "minimist": "1.2.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/minimist": "1.2.5",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
