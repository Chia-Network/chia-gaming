{
  "name": "chia-gaming",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "./tools/build-deploy.sh",
    "build:check": "./cb.sh",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "dev": "./run-local-demo.sh",
    "format": "prettier --write 'desktop/src/**/*.ts' 'desktop/scripts/**/*.mjs' 'desktop/packaging/**/*.cjs' 'desktop/renderer/**/*.{html,mjs}' 'desktop/*.{ts,js,mjs,cjs,json}' 'front-end/src/**/*.{ts,tsx,js,jsx,mjs,json,css}' 'front-end/scripts/**/*.{ts,js,mjs}' 'front-end/*.{ts,js,mjs,json}' 'front-end/public/**/*.html' 'hub/*/src/**/*.{ts,tsx,js,jsx,mjs,json}' 'hub/*/*.{ts,js,mjs,json}' '*.{ts,js,mjs,json}'",
    "format:check": "prettier --check 'desktop/src/**/*.ts' 'desktop/scripts/**/*.mjs' 'desktop/packaging/**/*.cjs' 'desktop/renderer/**/*.{html,mjs}' 'desktop/*.{ts,js,mjs,cjs,json}' 'front-end/src/**/*.{ts,tsx,js,jsx,mjs,json,css}' 'front-end/scripts/**/*.{ts,js,mjs}' 'front-end/*.{ts,js,mjs,json}' 'front-end/public/**/*.html' 'hub/*/src/**/*.{ts,tsx,js,jsx,mjs,json}' 'hub/*/*.{ts,js,mjs,json}' '*.{ts,js,mjs,json}'",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "start": "./run-local-demo.sh --skip-build",
    "test": "./ct.sh",
    "test:js": "./tools/local-wasm-tests.sh",
    "typecheck": "pnpm --filter chia-gaming-fe exec tsc --project tsconfig.json --noEmit && pnpm --filter chia-gaming-hub-frontend exec tsc --project tsconfig.json --noEmit && pnpm --filter chia-gaming-hub-service exec tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "prettier": "3.5.3",
    "typescript-eslint": "8.65.0"
  }
}
