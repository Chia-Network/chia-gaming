{
  "name": "chia-gaming-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Hardened Electron shell for the Chia Gaming player app",
  "homepage": "https://github.com/Chia-Network/chia-gaming/",
  "license": "Apache-2.0",
  "author": "Chia Gaming",
  "desktopName": "Chia Gaming",
  "type": "module",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "tsc --project .",
    "test": "node --test src/main/*.test.ts",
    "test:lobby": "node --test --test-timeout=120000 workers/lobby.test.cjs",
    "loadtest:lobby": "node workers/lobby.loadtest.cjs",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --external:pear-runtime --outfile=dist/main/index.cjs --sourcemap",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node22 --format=cjs --external:electron --outfile=dist/preload/index.cjs --sourcemap",
    "stage": "node scripts/stage-renderer.mjs",
    "build": "pnpm run typecheck && pnpm run test && pnpm run build:main && pnpm run build:preload && pnpm run stage",
    "start": "pnpm run build && electron .",
    "package": "pnpm run build && node scripts/package-app.mjs"
  },
  "devDependencies": {
    "@types/node": "24.6.2",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.11",
    "hyperdht": "6.34.1",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "dependencies": {
    "b4a": "1.9.0",
    "bare-path": "3.1.2",
    "corestore": "7.14.0",
    "framed-stream": "1.0.1",
    "hypercore-crypto": "3.7.0",
    "hyperswarm": "4.17.2",
    "pear-runtime": "1.3.1"
  }
}
