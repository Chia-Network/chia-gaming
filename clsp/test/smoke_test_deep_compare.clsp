(include *standard-cl-26*)
(import std.print)
(import std.prepend)
(import std.sort)
(import std.assert)
(import std.map)
(import std.deep_compare)

(export ()
   (map
     (lambda ((want_cmp_val cmp_a cmp_b))
       (= (deep_compare cmp_a cmp_b) want_cmp_val)
       )
     (q
      (0 0 0)
      (-1 () (1 14 5 4 3 2))
      (1 (1 14 5 4 3 2) ())
      (-1 "X" (1 2))
      (1 (1 2) "X")
      (0 (3 2) (3 2))
      (-1 (3 1) (3 3))
      (1 (3 3) (3 1))
      (-1 (1 1) (2 1))
      (1 (3 1) (2 2))
      (-1 (2 2) (3 1))
      )
     )
   )
