(include *standard-cl-23*)
(import std.assert)
(import std.curry)
(import std.shatree)
(import std.relops)
(import std.condition_codes)
(import std.li)
(import std.append)
(import std.shapes)
(import referee.shapes)

;
; Adjudicates a two-player turn-based game.
;
; MOVE, INFOHASH_B, and MOVER_SHARE are accepted optimistically from the
; previous move.
;
; INFOHASH_A and INFOHASH_B are commitments:
;   sha256(validation_program_hash, shatree(state))
;
; In slash, this puzzle runs previous_validation_program against all_args.
; The validator returns ((next_validator_hash . new_state) . (max_move_size . extra_conditions)).
; Slash succeeds in three cases:
;   1. validator_result is nil (0) — unconditional slash.
;   2. validator_result is non-nil but its (next_validator_hash, new_state,
;      max_move_size) misalign with this coin's commitments — unconditional.
;   3. validator_result is non-nil, values align with commitments, AND there
;      are extra conditions in the conditions field — conditional slash. The extra
;      conditions are prepended to payout_conditions (e.g. AGG_SIG_UNSAFE
;      for signed dictionary range proofs).
; If validator_result is non-nil, values align, and there are no extra
; conditions (the conditions field is nil), the move was valid and the slash
; attempt fails (assert aborts the spend).
;
; MOVER_SHARE is how much the mover gets if they fold/accept timeout.
; MOD_HASH should be the shatree of referee itself.
; NONCE is for anti-replay prevention.
;
; Validation programs get (mod_hash . all_args) where all_args is
; (curried_args . slash_solution_args). See referee.shapes for the shared
; layouts. Validators ignore the payout field.

; The curried argument is a balanced tree; every field is at most four edges
; deep. Keep this shape aligned with RefereePuzzleArgs::to_clvm and validators.
(export (@ all_args
    ((referee-parameters) . args))
    (if-shape args
        ((referee-timeout)
            (li (list ASSERT_HEIGHT_RELATIVE TIMEOUT)
                (if MOVER_SHARE (list CREATE_COIN mover_payout_ph MOVER_SHARE) (assert (not mover_payout_ph) (list 1)))
                (i MOVER_SHARE (list AGG_SIG_UNSAFE MOVER_PUBKEY (concat 0x78 mover_payout_ph)) (list 1))
                &rest
                (if (- AMOUNT MOVER_SHARE)
                    (list
                        (list CREATE_COIN waiter_payout_ph (- AMOUNT MOVER_SHARE))
                        (list AGG_SIG_UNSAFE WAITER_PUBKEY (concat 0x78 waiter_payout_ph)))
                    (assert (not waiter_payout_ph) ())
                )
            )
        )
        ((referee-slash)
            (assign
                previous_validation_program_hash (shatree previous_validation_program)
                validator_result
                    (a previous_validation_program (c previous_validation_program_hash all_args))
                payout_conditions (list
                    (list CREATE_COIN mover_payout_ph AMOUNT)
                    (list AGG_SIG_UNSAFE MOVER_PUBKEY (concat 0x78 mover_payout_ph))
                )

                (assert
                    (= INFOHASH_A (sha256 previous_validation_program_hash (shatree previous_state)))
                    (if-shape validator_result
                        (nil payout_conditions)
                        ((referee-result)
                            (if (not (logand
                                    (= (i next_validator_hash
                                            (sha256 next_validator_hash (shatree new_state))
                                            0)
                                        INFOHASH_B)
                                    (= max_move_size MAX_MOVE_SIZE)
                                    (i next_validator_hash 1 (not max_move_size))))
                                payout_conditions
                                (assert extra_conditions
                                    (append extra_conditions payout_conditions)
                                )
                            )
                        )
                    )
                )
            )
        )
        ((referee-move)
            (assign
                new_puzzle_hash (curry_hashes MOD_HASH
                    (shatree
                        (make (referee-parameters WAITER_PUBKEY MOVER_PUBKEY
                                    TIMEOUT AMOUNT MOD_HASH NONCE
                                    new_move new_max_move_size infohash_c
                                    new_mover_share INFOHASH_B))))
                (assert
                    INFOHASH_B
                    (<= (strlen new_move) MAX_MOVE_SIZE)
                    (<= (strlen new_max_move_size) 2)
                    (>= new_max_move_size 0)
                    (= new_max_move_size (+ new_max_move_size 0))
                    (<= new_mover_share AMOUNT)
                    (>= new_mover_share 0)
                    (= new_mover_share (+ new_mover_share 0))
                    (logior (not infohash_c) (= 32 (strlen infohash_c)))
                    (i infohash_c 1 (not new_max_move_size))
                    (list
                            (list ASSERT_BEFORE_HEIGHT_RELATIVE TIMEOUT)
                            (list CREATE_COIN new_puzzle_hash AMOUNT)
                            (list AGG_SIG_ME MOVER_PUBKEY (shatree args)))
                )
            )
        )
    )
)
