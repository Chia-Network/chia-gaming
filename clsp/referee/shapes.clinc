(import std.shapes)

; Keep the Rust encoders/decoder in src/referee/types.rs aligned with these.
(defun-shape referee-parameters
    #(MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
      MOVE MAX_MOVE_SIZE INFOHASH_B MOVER_SHARE INFOHASH_A))

(defun-shape referee-timeout
    ((atom mover_payout_ph) . (atom waiter_payout_ph)))

(defun-shape referee-move
    #((atom new_move) (atom infohash_c) (atom new_mover_share) (atom new_max_move_size)))

; A pair on the left and an atom on the right distinguishes slash from both
; timeout (two atoms) and move (two pairs). Evidence contributes no constraints.
(defun-shape referee-slash
    ((previous_state previous_validation_program . (optional evidence)) . (atom mover_payout_ph)))

; Shared by on-chain validators and off-chain validation. Payout is unused by
; validators; off-chain calls supply nil there. No terminating list nils.
(defun-shape referee-validator-args
    (validator_hash curried_args (state validation_program . evidence) . payout))
