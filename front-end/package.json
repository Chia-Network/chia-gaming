{
  "name": "chia-gaming-fe",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Chia Gaming Frontend and Hub Server",
  "main": "dist/js/index-rollup.cjs",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "generate:games": "node scripts/generate-game-registry.mjs",
    "build": "pnpm run generate:games && pnpm exec tsc --project . --noEmit && pnpm exec esbuild src/index.tsx --bundle --sourcemap --jsx=automatic --outfile=dist/js/index-rollup.js --alias:@=./src --alias:@games=../games && pnpm exec tailwindcss -i ./src/index.css -o ./dist/css/index.css",
    "build:deploy": "pnpm run generate:games && pnpm exec tsc --project . --noEmit && pnpm exec esbuild src/index.tsx --bundle --format=esm --splitting --jsx=automatic --outdir=dist/app --alias:@=./src --alias:@games=../games && pnpm exec tailwindcss -i ./src/index.css -o ./dist/app/index.css",
    "bundle": "rm -rf dist/app && pnpm run build:deploy && node scripts/assemble-bundle.mjs",
    "test": "pnpm run generate:games && pnpm exec tsc -p tsconfig.json --noEmit && pnpm exec jest --silent=false --verbose --useStderr --ci"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@walletconnect/sign-client": "2.23.10",
    "@walletconnect/types": "2.23.10",
    "bech32": "^2.0.0",
    "chia-gaming-bencodex": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "clvm-lib": "1.0.1",
    "framer-motion": "12.43.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "esbuild": "0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jest": "30.4.2",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "setupFilesAfterEnv": [
      "<rootDir>/scripts/testSetup.ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/../games"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/../games/*/ui/**/*.{spec,test}.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/src/features/"
    ],
    "moduleDirectories": [
      "node_modules",
      "node-pkg",
      "src"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@games/(.*)$": "<rootDir>/../games/$1",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/scripts/testMock.js",
      "\\.(css|less)$": "<rootDir>/scripts/testMock.js"
    },
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist"
    ],
    "transformIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/dist",
      "<rootDir>/node-pkg",
      "/app/node_modules"
    ],
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ]
  }
}
