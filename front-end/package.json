{
  "name": "chia-gaming-fe",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Chia Gaming Frontend and Hub Server",
  "main": "dist/js/index-rollup.cjs",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "generate:games": "node scripts/generate-game-registry.mjs",
    "build": "node scripts/build.mjs",
    "build:deploy": "node scripts/build.mjs --deploy",
    "bundle": "node scripts/build.mjs --bundle",
    "test": "pnpm run generate:games && pnpm exec tsc -p tsconfig.json --noEmit && pnpm exec jest --testPathIgnorePatterns=load_wasm --silent=false --verbose --useStderr --ci --forceExit && node -e \"console.error('=== WASM/Jest load_wasm starting ===')\" && pnpm exec jest --runInBand --testPathPatterns=load_wasm --silent=false --verbose --useStderr --ci --forceExit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@walletconnect/sign-client": "2.23.10",
    "@walletconnect/types": "2.26.0",
    "bech32": "^2.0.0",
    "chia-gaming-bencodex": "workspace:*",
    "chia-gaming-protocol-constants": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clvm-lib": "1.0.1",
    "cn": "0.5.2",
    "framer-motion": "14.14.0",
    "lucide-react": "1.74.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.8",
    "jest": "30.5.2",
    "react-test-renderer": "19.3.1",
    "tailwindcss": "4.3.5",
    "ts-jest": "29.4.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ws": "8.23.0"
  },
  "jest": {
    "preset": "ts-jest",
    "setupFilesAfterEnv": [
      "<rootDir>/scripts/testSetup.ts"
    ],
    "roots": [
      "<rootDir>/src",
      "<rootDir>/../games"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/../games/*/ui/**/*.{spec,test}.{ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/src/features/"
    ],
    "moduleDirectories": [
      "node_modules",
      "node-pkg",
      "src"
    ],
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react",
      "^react-dom$": "<rootDir>/node_modules/react-dom",
      "^react/jsx-runtime$": "<rootDir>/node_modules/react/jsx-runtime",
      "^react/jsx-dev-runtime$": "<rootDir>/node_modules/react/jsx-dev-runtime",
      "^react-test-renderer$": "<rootDir>/node_modules/react-test-renderer",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@games/(.*)$": "<rootDir>/../games/$1",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/scripts/testMock.js",
      "\\.(css|less)$": "<rootDir>/scripts/testMock.js"
    },
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist"
    ],
    "transformIgnorePatterns": [
      "<rootDir>/node_modules",
      "<rootDir>/dist",
      "<rootDir>/node-pkg",
      "/app/node_modules"
    ],
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ]
  }
}
