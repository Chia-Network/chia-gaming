import shapes::*;

fn main(
    _mod_hash: Bytes32,
    params: RefereeParams,
    _witness: Any,
    ..._unused_payout: Any,
) -> ValidatorTransition<String> {
    if params.validation_info_hash != nil {
        raise ["committed validator execution"];
    } else {
        validator_transition(
            0x1111111111111111111111111111111111111111111111111111111111111111,
            "derived state",
            32,
        )
    }
}
