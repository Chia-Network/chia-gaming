import common::*;
import shapes::*;

fn main(_mod_hash: Any, params: RefereeParams, _witness: Any, ..._unused_payout: Any) -> Any {
    if truthy(params.validation_info_hash) {
        raise ["committed validator execution"];
    } else {
        validator_transition(
            0x1111111111111111111111111111111111111111111111111111111111111111,
            "derived state",
            32,
        )
    }
}
