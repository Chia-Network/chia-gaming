import handler_types::{FactoryRecord, MyTurnResult};

// Test-side view of the existing Rust factory and first-turn handler ABI.
export type FirstTurn = fn(
    move: Any,
    amount: Int,
    state: Any,
    share: Int,
    entropy: Bytes32,
) -> MyTurnResult | [String, Bytes];

type Record = FactoryRecord<Any, Any, FirstTurn>;

export fn first_record(result: Any) -> Record {
    let [success, [record, ..._]] = unchecked_cast::<[Int, [Record, ...Any]]>(result);
    assert success == 1;
    record
}
