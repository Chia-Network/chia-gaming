// Compare the nonempty integer ranks lexicographically. Equal ranks have the same length.
export fn list_compare(a: List<Int>, b: List<Int>) -> Int {
    assert a is (Int, List<Int>);
    assert b is (Int, List<Int>);
    if a.first != b.first {
        inline if a.first > b.first { 1 } else { -1 }
    } else if a.rest is nil {
        0
    } else {
        list_compare(a.rest, b.rest)
    }
}
