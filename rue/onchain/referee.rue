import shapes::{RefereeCoin, RefereeMove, RefereeParams, RefereePubkeys, ValidatorTransition};

type Move = ((Bytes, Bytes), (Int, Int));
type Timeout = (Bytes, Bytes);

type Validator = fn(hash: Bytes32, params: RefereeParams, ...solution: Any) -> Bytes
    | ValidatorTransition;

type Slash = ((Any, (Validator, Any)), Bytes);

fn main(params: RefereeParams, ...solution: Move | Timeout | Slash) -> List<Any> {
    let {
        coin: { pubkeys: { mover, waiter }, timeout, amount, mod_hash },
        move_data: { nonce, max_move_size: max_size },
        validation_info_hash: info_b,
        mover_share: share,
        previous_validation_info_hash: info_a,
    } = params;
    match solution {
        // Only Move has a pair on the right, so dispatch needs one pair test.
        (Any, (Any, Any)) as ((new_move, info_c), (new_share, new_max)) => {
            assert info_b != nil;
            assert new_move.length <= max_size;
            assert (new_max as Bytes).length <= 2 && new_max >= 0 && new_max == new_max + 0;
            assert new_share <= amount && new_share >= 0 && new_share == new_share + 0;
            assert info_c == nil || info_c.length == 32;
            assert info_c != nil || new_max == 0;
            let next_params = RefereeParams {
                coin: RefereeCoin {
                    pubkeys: RefereePubkeys { mover: waiter, waiter: mover },
                    timeout,
                    amount,
                    mod_hash,
                },
                move_data: RefereeMove { nonce, move: new_move, max_move_size: new_max },
                validation_info_hash: info_c,
                mover_share: new_share,
                previous_validation_info_hash: info_b,
            };
            [
                [ASSERT_BEFORE_HEIGHT_RELATIVE, timeout],
                [CREATE_COIN, curry_tree_hash(mod_hash, [tree_hash(next_params)]), amount],
                [AGG_SIG_ME, mover, tree_hash(solution)],
            ]
        }
        Timeout as (mover_ph, waiter_ph) => {
            let remainder = amount - share;
            let waiter_conditions = if remainder != 0 {
                [[CREATE_COIN, waiter_ph, remainder], [AGG_SIG_UNSAFE, waiter, "x" + waiter_ph]]
            } else {
                assert waiter_ph == nil;
                nil
            };
            let (coin, signature) = if share != 0 {
                ([CREATE_COIN, mover_ph, share], [AGG_SIG_UNSAFE, mover, "x" + mover_ph])
            } else {
                assert mover_ph == nil;
                ([1], [1])
            };
            [[ASSERT_HEIGHT_RELATIVE, timeout], coin, signature, ...waiter_conditions]
        }
        Slash as ((state, (program, _)), payout_ph) => {
            let hash = tree_hash(program);
            assert info_a == sha256(hash + tree_hash(state));
            let result = program(hash, params, ...solution);
            let payout = [
                [CREATE_COIN, payout_ph, amount],
                [AGG_SIG_UNSAFE, mover, "x" + payout_ph],
            ];
            if result is Bytes {
                assert result == nil;
                payout
            } else {
                let ((next_hash, next_state), (size, extra)) = result;
                let commitment: Bytes = if next_hash != nil {
                    sha256(next_hash + tree_hash(next_state))
                } else {
                    nil
                };
                if commitment != info_b || size != max_size || (next_hash == nil && size != 0) {
                    payout
                } else {
                    assert extra is (Any, Any);
                    [...extra, ...payout]
                }
            }
        }
    }
}
