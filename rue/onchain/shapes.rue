// Each final spread field is a CLVM pair tail. Together these structs match
// the eleven-field balanced tree in RefereePuzzleArgs::to_clvm.
export struct RefereeParams {
    coin: RefereeCoin,
    move_data: RefereeMove,
    validation_info_hash: Bytes,
    mover_share: Int,
    ...previous_validation_info_hash: Bytes,
}

export struct RefereeCoin {
    pubkeys: RefereePubkeys,
    timeout: Int,
    amount: Int,
    ...mod_hash: Bytes32,
}

export struct RefereePubkeys {
    mover: PublicKey,
    ...waiter: PublicKey,
}

export struct RefereeMove {
    nonce: Int,
    move: Bytes,
    ...max_move_size: Int,
}

export type ValidatorResult = 0 | ValidatorTransition;
export type ValidatorTransition = ((Bytes, Any), (Int, List<Any>));

export inline fn validator_result(
    next_validator_hash: Bytes,
    new_state: Any,
    max_move_size: Int,
    extra_conditions: List<Any>,
) -> ValidatorTransition {
    ((next_validator_hash, new_state), (max_move_size, extra_conditions))
}

export inline fn validator_transition(
    next_validator_hash: Bytes,
    new_state: Any,
    max_move_size: Int,
) -> ValidatorTransition {
    validator_result(next_validator_hash, new_state, max_move_size, nil)
}

// The validator receives its previous state, the program reveal and an arbitrary
// evidence tail. Off-chain evaluation supplies nil for the separate payout tail.
export type Witness<S, E> = (S, (Any, E));
