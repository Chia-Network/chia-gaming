// Rust encodes the eleven curried fields as a tree split at len / 2.
export type Parameters = (
    ((PublicKey, PublicKey), (Int, (Int, Bytes32))),
    ((Int, (Bytes, Int)), (Bytes, (Int, Bytes))),
);

export inline fn validator_result(
    next_validator_hash: Any,
    new_state: Any,
    max_move_size: Any,
    extra_conditions: Any,
) -> Any {
    ((next_validator_hash, new_state), (max_move_size, extra_conditions))
}

export inline fn validator_transition(
    next_validator_hash: Any,
    new_state: Any,
    max_move_size: Any,
) -> Any {
    validator_result(next_validator_hash, new_state, max_move_size, nil)
}

// The validator receives its previous state, the program reveal and an arbitrary
// evidence tail. Off-chain evaluation supplies nil for the separate payout tail.
export type Witness<S> = (S, (Any, Any));

export struct Turn {
    amount: Int,
    move: Bytes,
    mover_share: Int,
    info_hash: Bytes,
}

export inline fn turn(params: Parameters) -> Turn {
    let ((_, (_, (amount, _))), ((_, (move, _)), (info_hash, (mover_share, _)))) = params;
    Turn { amount, move, mover_share, info_hash }
}
