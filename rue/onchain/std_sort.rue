// Merge sort alternates cards between the two halves.
fn split<T>(items: List<T>, left: List<T>, right: List<T>) -> (List<T>, List<T>) {
    if items is nil {
        (left, right)
    } else {
        split(items.rest, right, [items.first, ...left])
    }
}

fn merge<T>(less: fn(a: T, b: T) -> Bool, left: List<T>, right: List<T>) -> List<T> {
    if left is nil {
        return right;
    }
    if right is nil {
        return left;
    }
    if less(left.first, right.first) {
        [left.first, ...merge(less, left.rest, right)]
    } else {
        [right.first, ...merge(less, left, right.rest)]
    }
}

export fn sort_list<T>(less: fn(a: T, b: T) -> Bool, items: List<T>) -> List<T> {
    if items is nil || items.rest is nil {
        return items;
    }
    let (left, right) = split(items, nil, nil);
    merge(less, sort_list(less, left), sort_list(less, right))
}
