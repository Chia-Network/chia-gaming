import artifacts::{spacepoker_commitA_hash, spacepoker_factory_program};
import factory_record::first_record;

test fn factory_links_first_validator_and_opens_with_chain_tip() {
    let record = first_record(spacepoker_factory_program(...[100, 100, [5, 2]]));
    assert record.validation_programs is (Any, List<Any>);
    assert tree_hash(record.validation_programs.first) == spacepoker_commitA_hash;
    let entropy = sha256("spacepoker");
    let reply = record.my_turn_handler(nil, 20, record.initial_state, 0, entropy);
    assert !(reply is [String, Bytes]);
    let [label, move, share, _, ...parser] = reply;
    assert parser is nil;
    assert label == "spacepoker_alice_commitA";
    assert move == sha256(sha256(sha256(sha256(sha256(entropy[..16])))));
    assert share == 10;
}
