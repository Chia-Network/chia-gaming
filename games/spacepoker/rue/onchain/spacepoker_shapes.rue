// Fixed records use the balanced pair layout shared by validators and handlers.
export type Commit = (Any, Any);
export type Open = ((Any, (Any, Any)), (Any, (Any, Any)));
export type Raise = ((Any, (Any, Any)), (Any, (Any, Any)));
export type End = (Any, (Any, Any));

// Alice and Bob label the first and second preimages passed to the deal.
export struct Cards {
    hands: Hands,
    alice_boost: Bool,
    ...bob_boost: Bool,
}

export struct Hands {
    alice_cards: List<Any>,
    ...bob_cards: List<Any>,
}

export inline fn make_space_commit(bet_unit: Any, alice_image: Any) -> Commit {
    (bet_unit, alice_image)
}

export inline fn make_space_open(
    bet_unit: Any,
    half_pot: Any,
    mover_image: Any,
    waiter_image: Any,
    round: Any,
    mid_hash: Any,
) -> Open {
    ((bet_unit, (half_pot, mover_image)), (waiter_image, (round, mid_hash)))
}

export inline fn make_space_raise(
    bet_unit: Any,
    half_pot: Any,
    last_raise: Any,
    mover_image: Any,
    waiter_image: Any,
    round: Any,
) -> Raise {
    ((bet_unit, (half_pot, last_raise)), (mover_image, (waiter_image, round)))
}

export inline fn make_space_end(half_pot: Any, mover_image: Any, waiter_preimage: Any) -> End {
    (half_pot, (mover_image, waiter_preimage))
}
