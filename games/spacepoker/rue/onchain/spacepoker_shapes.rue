// Fixed records use the balanced pair layout shared by validators and handlers.
export type Commit = (Int, Bytes);
export type Open = ((Int, (Int, Bytes)), (Bytes, (Int, Bytes)));
export type Raise = ((Int, (Int, Int)), (Bytes, (Bytes, Int)));
export type End = (Int, (Bytes, Bytes));

// Alice and Bob label the first and second preimages passed to the deal.
export struct Cards {
    hands: Hands,
    alice_boost: Bool,
    ...bob_boost: Bool,
}

export type SevenCards = [Int, Int, Int, Int, Int, Int, Int];

export struct Hands {
    alice_cards: SevenCards,
    ...bob_cards: SevenCards,
}

export inline fn make_space_commit(bet_unit: Int, alice_image: Bytes) -> Commit {
    (bet_unit, alice_image)
}

export inline fn make_space_open(
    bet_unit: Int,
    half_pot: Int,
    mover_image: Bytes,
    waiter_image: Bytes,
    round: Int,
    mid_hash: Bytes,
) -> Open {
    ((bet_unit, (half_pot, mover_image)), (waiter_image, (round, mid_hash)))
}

export inline fn make_space_raise(
    bet_unit: Int,
    half_pot: Int,
    last_raise: Int,
    mover_image: Bytes,
    waiter_image: Bytes,
    round: Int,
) -> Raise {
    ((bet_unit, (half_pot, last_raise)), (mover_image, (waiter_image, round)))
}

export inline fn make_space_end(half_pot: Int, mover_image: Bytes, waiter_preimage: Bytes) -> End {
    (half_pot, (mover_image, waiter_preimage))
}
