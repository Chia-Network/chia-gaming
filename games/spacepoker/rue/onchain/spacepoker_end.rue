import common::*;
import shapes::*;
import space_hand_eval::*;
import spacepoker_shapes::*;
import std_deep_compare::*;
import std_popcount::*;

// state is (space-end)
// MOVE is mover's preimage (16 bytes) concatenated with card selection bitfield (1 byte)
// evidence is waiter's card selection bitfield
fn main(_mod_hash: Any, params: Parameters, witness: Witness<End>, ..._unused_payout: Any) -> Any {
    let { amount, move, mover_share, info_hash: validation_info_hash } = turn(params);
    let ((half_pot, (mover_image, waiter_preimage)), (_, evidence)) = witness;
    if (move.length == 17)
        && !truthy(validation_info_hash)
        && (bytes(mover_image) == sha256(move[0..16]))
    {
        let mover_bitfield = move[16..17];
        if !truthy((mover_bitfield as Int) & (0x80 as Int))
            && (integer(popcount(mover_bitfield)) == 5)
        {
            if !truthy(evidence) {
                validator_transition(0, 0, 0)
            } else {
                let (
                    (mover_cards, waiter_cards),
                    (mover_boost, waiter_boost),
                ) = unchecked_cast::<((Any, Any), (Any, Any))>(make_all_cards(
                    move[0..16],
                    waiter_preimage,
                ));
                let mover_selected = pull_from_bitfield(mover_cards, mover_bitfield);
                assert bytes(evidence).length == 1;
                assert !truthy(integer(evidence) & (0x80 as Int));
                assert integer(popcount(evidence)) == 5;
                let waiter_selected = pull_from_bitfield(waiter_cards, evidence);
                let fair_share = {
                    let result = deep_compare(
                        space_hand_eval(mover_selected, mover_boost),
                        space_hand_eval(waiter_selected, waiter_boost),
                    );
                    if !truthy(result) {
                        amount / 2
                    } else if integer(result) == 1 {
                        (amount / 2) - integer(half_pot)
                    } else {
                        (amount / 2) + integer(half_pot)
                    }
                };
                if mover_share < integer(fair_share) {
                    0
                } else {
                    validator_transition(0, 0, 0)
                }
            }
        } else {
            0
        }
    } else {
        0
    }
}

export fn pull_from_bitfield(cards: Any, bitfield: Any) -> Any {
    if !truthy(cards) {
        0
    } else {
        let remaining = pull_from_bitfield(pair(cards).rest, integer(bitfield) >>> 1);
        if truthy(integer(bitfield) & 1) {
            (pair(cards).first, remaining)
        } else {
            remaining
        }
    }
}

// Community cards are revealed in the order: flop (3 cards from chain
// position 3, revealed first), turn (1 card from position 2), river (1
// card from position 1). The card list order here must match
// derive_all_cards in spacepoker_generate.clinc so the bitfield indexes
// the same cards on both sides.
export fn make_all_cards(alice_pre: Any, bob_pre: Any) -> Any {
    let alice_image_1 = sha256(bytes(alice_pre));
    let alice_image_2 = sha256(alice_image_1);
    let alice_image_3 = sha256(alice_image_2);
    let alice_image_4 = sha256(alice_image_3);
    let bob_image_1 = sha256(bytes(bob_pre));
    let bob_image_2 = sha256(bob_image_1);
    let bob_image_3 = sha256(bob_image_2);
    let bob_image_4 = sha256(bob_image_3);
    let [flop_1, flop_2, flop_3, ..._] = unchecked_cast::<[Any, Any, Any, ...Any]>(make_cards(
        alice_image_3,
        bob_image_3,
        3,
    ));
    let turn_card = pair(make_cards(alice_image_2, bob_image_2, 1)).first;
    let river_card = pair(make_cards(alice_image_1, bob_image_1, 1)).first;
    let (alice_hole_1, (alice_hole_2, _)) = unchecked_cast::<(Any, (Any, Any))>(make_cards(
        alice_pre,
        bob_image_4,
        2,
    ));
    let (bob_hole_1, (bob_hole_2, _)) = unchecked_cast::<(Any, (Any, Any))>(make_cards(
        bob_pre,
        alice_image_4,
        2,
    ));
    let alice_cards = [alice_hole_1, alice_hole_2, flop_1, flop_2, flop_3, turn_card, river_card];
    let bob_cards = [bob_hole_1, bob_hole_2, flop_1, flop_2, flop_3, turn_card, river_card];
    let alice_boost = !truthy(
        (sha256((integer(alice_pre) ^ (bob_image_4 as Int)) as Bytes) as Int) % 3,
    );
    let bob_boost = !truthy(
        (sha256((integer(bob_pre) ^ (alice_image_4 as Int)) as Bytes) as Int) % 3,
    );
    make_space_cards(alice_cards, bob_cards, alice_boost, bob_boost)
}

export fn make_cards(thing1: Any, thing2: Any, num_cards: Any) -> Any {
    extract_cards(sha256((integer(thing1) ^ integer(thing2)) as Bytes), num_cards)
}

export fn extract_cards(value: Any, num_cards: Any) -> Any {
    if !truthy(num_cards) {
        0
    } else {
        let (nextval, next_card) = unchecked_cast::<(Any, Any)>(divmod(integer(value), 13));
        ((2 + integer(next_card)), extract_cards(nextval, integer(num_cards) - 1))
    }
}
