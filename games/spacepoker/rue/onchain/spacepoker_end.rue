import shapes::*;
import space_hand_eval::*;
import spacepoker_cards::{make_all_cards, pull_from_bitfield};
import spacepoker_shapes::*;
import std_deep_compare::*;
import std_popcount::*;

// state is (space-end)
// MOVE is mover's preimage (16 bytes) concatenated with card selection bitfield (1 byte)
// evidence is waiter's card selection bitfield
fn main(
    _mod_hash: Bytes32,
    params: RefereeParams,
    witness: Witness<End, Bytes>,
    ..._unused_payout: Any,
) -> ValidatorResult {
    let { coin: { amount }, move_data: { move }, mover_share, validation_info_hash } = params;
    let ((half_pot, (mover_image, waiter_preimage)), (_, evidence)) = witness;
    if (move.length == 17) && validation_info_hash is nil && (mover_image == sha256(move[0..16])) {
        let mover_bitfield = move[16..17];
        if ((mover_bitfield as Int) & (0x80 as Int)) == 0
            && (popcount(mover_bitfield as Int) == 5)
        {
            if evidence is nil {
                validator_transition(nil, 0, 0)
            } else {
                let {
                    hands: { alice_cards: mover_cards, bob_cards: waiter_cards },
                    alice_boost: mover_boost,
                    bob_boost: waiter_boost,
                } = make_all_cards(move[0..16], waiter_preimage);
                let mover_selected = pull_from_bitfield(mover_cards, mover_bitfield as Int);
                assert evidence.length == 1;
                assert ((evidence as Int) & (0x80 as Int)) == 0;
                assert popcount(evidence as Int) == 5;
                let waiter_selected = pull_from_bitfield(waiter_cards, evidence as Int);
                let fair_share = {
                    let result = deep_compare(
                        space_hand_eval(mover_selected, mover_boost),
                        space_hand_eval(waiter_selected, waiter_boost),
                    );
                    if result == 0 {
                        amount / 2
                    } else if result == 1 {
                        (amount / 2) - half_pot
                    } else {
                        (amount / 2) + half_pot
                    }
                };
                if mover_share < fair_share {
                    0
                } else {
                    validator_transition(nil, 0, 0)
                }
            }
        } else {
            0
        }
    } else {
        0
    }
}
