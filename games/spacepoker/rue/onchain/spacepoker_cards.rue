import spacepoker_shapes::{Cards, Hands};

export fn pull_from_bitfield(cards: List<Int>, bitfield: Int) -> List<Int> {
    if cards is nil {
        nil
    } else {
        let remaining = pull_from_bitfield(cards.rest, bitfield >>> 1);
        inline if bitfield & 1 != 0 { (cards.first, remaining) } else { remaining }
    }
}

// Community cards are revealed in the order: flop (3 cards from chain
// position 3, revealed first), turn (1 card from position 2), river (1
// card from position 1). Selection bitfields index the two hole cards first.
export fn make_all_cards(alice_pre: Bytes, bob_pre: Bytes) -> Cards {
    let alice_image_1 = sha256(alice_pre);
    let alice_image_2 = sha256(alice_image_1);
    let alice_image_3 = sha256(alice_image_2);
    let alice_image_4 = sha256(alice_image_3);
    let bob_image_1 = sha256(bob_pre);
    let bob_image_2 = sha256(bob_image_1);
    let bob_image_3 = sha256(bob_image_2);
    let bob_image_4 = sha256(bob_image_3);
    let [flop_1, flop_2, flop_3] = flop(deal_seed(alice_image_3, bob_image_3));
    let turn_card = card_rank(deal_seed(alice_image_2, bob_image_2));
    let river_card = card_rank(deal_seed(alice_image_1, bob_image_1));
    let ([alice_hole_1, alice_hole_2], alice_boost) = deal_hole_cards(alice_pre, bob_image_4);
    let ([bob_hole_1, bob_hole_2], bob_boost) = deal_hole_cards(bob_pre, alice_image_4);
    let alice_cards = [alice_hole_1, alice_hole_2, flop_1, flop_2, flop_3, turn_card, river_card];
    let bob_cards = [bob_hole_1, bob_hole_2, flop_1, flop_2, flop_3, turn_card, river_card];
    Cards { hands: Hands { alice_cards, bob_cards }, alice_boost, bob_boost }
}

fn deal_seed(own_image: Bytes, other_image: Bytes) -> Int {
    sha256(((own_image as Int) ^ (other_image as Int)) as Bytes) as Int
}

fn card_rank(seed: Int) -> Int {
    2 + seed % 13
}

inline fn flop(seed: Int) -> [Int, Int, Int] {
    let (rest, first) = divmod(seed, 13);
    let (last, second) = divmod(rest, 13);
    [2 + first, 2 + second, card_rank(last)]
}

export fn deal_hole_cards(preimage: Bytes, opponent_image_4: Bytes) -> ([Int, Int], Bool) {
    let seed = deal_seed(preimage, opponent_image_4);
    let (rest, first) = divmod(seed, 13);
    ([2 + first, card_rank(rest)], seed % 3 == 0)
}

// Position 3 reveals the flop. Positions 2 and 1 reveal the turn and river.
export inline fn community_cards_for_pos(
    own_image: Bytes,
    other_image: Bytes,
    pos: Int,
) -> List<Int> {
    let seed = deal_seed(own_image, other_image);
    if pos == 3 {
        flop(seed)
    } else {
        [card_rank(seed)]
    }
}
