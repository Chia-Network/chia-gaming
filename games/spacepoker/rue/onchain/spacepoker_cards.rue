import common::*;
import spacepoker_shapes::{Cards, Hands};

export fn pull_from_bitfield(cards: Any, bitfield: Any) -> Any {
    if !truthy(cards) {
        0
    } else {
        let remaining = pull_from_bitfield(pair(cards).rest, integer(bitfield) >>> 1);
        if truthy(integer(bitfield) & 1) {
            (pair(cards).first, remaining)
        } else {
            remaining
        }
    }
}

// Community cards are revealed in the order: flop (3 cards from chain
// position 3, revealed first), turn (1 card from position 2), river (1
// card from position 1). Selection bitfields index the two hole cards first.
export fn make_all_cards(alice_pre: Any, bob_pre: Any) -> Cards {
    let alice_image_1 = sha256(bytes(alice_pre));
    let alice_image_2 = sha256(alice_image_1);
    let alice_image_3 = sha256(alice_image_2);
    let alice_image_4 = sha256(alice_image_3);
    let bob_image_1 = sha256(bytes(bob_pre));
    let bob_image_2 = sha256(bob_image_1);
    let bob_image_3 = sha256(bob_image_2);
    let bob_image_4 = sha256(bob_image_3);
    let [flop_1, flop_2, flop_3, ..._] = unchecked_cast::<[Any, Any, Any, ...Any]>(community_cards_for_pos(
        alice_image_3,
        bob_image_3,
        3,
    ));
    let turn_card = pair(community_cards_for_pos(alice_image_2, bob_image_2, 2)).first;
    let river_card = pair(community_cards_for_pos(alice_image_1, bob_image_1, 1)).first;
    let ([alice_hole_1, alice_hole_2], alice_boost) = deal_hole_cards(alice_pre, bob_image_4);
    let ([bob_hole_1, bob_hole_2], bob_boost) = deal_hole_cards(bob_pre, alice_image_4);
    let alice_cards = [alice_hole_1, alice_hole_2, flop_1, flop_2, flop_3, turn_card, river_card];
    let bob_cards = [bob_hole_1, bob_hole_2, flop_1, flop_2, flop_3, turn_card, river_card];
    Cards { hands: Hands { alice_cards, bob_cards }, alice_boost, bob_boost }
}

inline fn deal_seed(own_image: Any, other_image: Any) -> Int {
    sha256((integer(own_image) ^ integer(other_image)) as Bytes) as Int
}

export inline fn deal_hole_cards(preimage: Any, opponent_image_4: Any) -> ([Int, Int], Bool) {
    let seed = deal_seed(preimage, opponent_image_4);
    (unchecked_cast::<[Int, Int]>(extract_cards(seed, 2)), seed % 3 == 0)
}

// Position 3 reveals the flop. Positions 2 and 1 reveal the turn and river.
export inline fn community_cards_for_pos(own_image: Any, other_image: Any, pos: Any) -> Any {
    extract_cards(deal_seed(own_image, other_image), inline if integer(pos) == 3 { 3 } else { 1 })
}

fn extract_cards(value: Any, num_cards: Any) -> Any {
    if !truthy(num_cards) {
        0
    } else {
        let (nextval, next_card) = unchecked_cast::<(Any, Any)>(divmod(integer(value), 13));
        ((2 + integer(next_card)), extract_cards(nextval, integer(num_cards) - 1))
    }
}
