import artifacts::{
    spacepoker_begin_round_program,
    spacepoker_commitA_program,
    spacepoker_commitB_program,
    spacepoker_end_program,
    spacepoker_mid_round_program,
};
import curry::curry_program;
import handler_types::{FactoryRecord, FactoryResult, MyTurnResult, OpeningHandler, TheirTurnResult};
import space_hand_calc::*;
import spacepoker_begin_round::{mover_opens_round, wins_opening_toss};
import spacepoker_cards::{
    community_cards_for_pos,
    deal_hole_cards,
    make_all_cards,
    pull_from_bitfield,
};
import spacepoker_end::showdown_mover_share;
import spacepoker_shapes::{Commit, End, Open, Raise};
import std_deep_compare::*;

// ─── hash chain helpers ───────────────────────────────────────────────
export fn build_image_chain(pre: Bytes) -> List<Bytes> {
    let i1 = sha256(pre);
    let i2 = sha256(i1);
    let i3 = sha256(i2);
    let i4 = sha256(i3);
    let i5 = sha256(i4);
    [pre, i1, i2, i3, i4, i5]
}

export fn image_at(chain: List<Bytes>, n: Int) -> Bytes {
    assert chain is (Bytes, List<Bytes>);
    if n == 0 {
        chain.first
    } else {
        image_at(chain.rest, n - 1)
    }
}

// Both players receive the opener's preimage to reveal the next community cards.
export fn parse_open_message(
    curried_chain: List<Bytes>,
    message: Bytes,
    state: Open,
    _amount: Int,
) -> [String, ...List<Int>] {
    let [(_, (_, mover_image_next)), _, round, ..._] = state;
    assert message.length == 32;
    assert sha256(message) == mover_image_next;
    ("cards", community_cards_for_pos(image_at(curried_chain, round), message, round))
}

// ─── deterministic factory ───────────────────────────────────────────
// Acceptance arguments:
// (proposer_reserve accepter_reserve (stack_size minimum_raise)).
// stack_size=0 selects the largest common stack rounded down to minimum_raise.
export type GameRecord = FactoryRecord<Int, [Int, Int], OpeningHandler<Int>>;
export type FactoryArgs = [Int, Int, (Int, (Int, Any)), ...Any];

export fn spacepoker_factory(...args: FactoryArgs) -> FactoryResult<GameRecord> {
    let [proposer_reserve, accepter_reserve, (stack_size, (minimum_raise, _)), ..._] = args;
    assert stack_size >= 0;
    assert minimum_raise > 0;
    assert minimum_raise == (minimum_raise + 0);
    assert deep_eq(args, [proposer_reserve, accepter_reserve, [stack_size, minimum_raise]]);
    let requested_stake = if stack_size != 0 {
        stack_size * minimum_raise
    } else {
        let reserve = inline if proposer_reserve < accepter_reserve {
            proposer_reserve
        } else {
            accepter_reserve
        };
        (reserve / minimum_raise) * minimum_raise
    };
    if requested_stake == 0
        || (requested_stake > proposer_reserve)
        || (requested_stake > accepter_reserve)
    {
        [
            0,
            if stack_size != 0 {
                requested_stake > proposer_reserve
            } else {
                proposer_reserve < minimum_raise
            },
            if stack_size != 0 {
                requested_stake > accepter_reserve
            } else {
                accepter_reserve < minimum_raise
            },
        ]
    } else {
        [
            1,
            [GameRecord {
                proposer_contribution: requested_stake,
                accepter_contribution: requested_stake,
                proposer_goes_first: true,
                initial_move: nil,
                initial_max_move_size: 32,
                initial_state: minimum_raise,
                initial_mover_share: 0,
                my_turn_handler: spacepoker_alice_commitA,
                their_turn_handler: spacepoker_bob_handler_commitA,
                validation_programs: [
                    spacepoker_commitA_program,
                    spacepoker_commitB_program,
                    spacepoker_begin_round_program,
                    spacepoker_mid_round_program,
                    spacepoker_end_program,
                ],
                readable_parameters: [requested_stake / minimum_raise, minimum_raise],
            }],
        ]
    }
}

// ─── Alice handlers (proposer, goes first) ───────────────────────────
// my-turn: Alice commits her hash-chain tip (image_5)
// state = bet_unit, local_move = nil (automatic)
export fn spacepoker_alice_commitA(
    _local_move: Any,
    amount: Int,
    _state: Int,
    _mover_share: Int,
    entropy: Bytes,
) -> MyTurnResult {
    let pre = entropy[0..16];
    let chain = build_image_chain(pre);
    let image_5 = image_at(chain, 5);
    [
        "spacepoker_alice_commitA",
        image_5,
        amount / 2,
        curry_program(spacepoker_alice_handler_commitB, [chain]),
    ]
}

// their-turn: Alice receives Bob's commitB
// state (after commitB validator) = (bet_unit bet_unit alice_i5 bob_i4 4 mid_hash)
// Returns a message (4th element) = alice_i4 so Bob can derive his hole cards.
// The "deal" readable's 5th element is the coin toss outcome: 1 if Alice
// opens, 0 if Alice must pong. The UX uses this to auto-play the pong
// or show the action bar.
export fn spacepoker_alice_handler_commitB(
    curried_chain: List<Bytes>,
    _amount: Int,
    _pre_state: Commit,
    state: Open,
    _move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    let [(bet_unit, (_half_pot, _alice_i5)), bob_i4, _N, ..._mid_hash] = state;
    let alice_pre = image_at(curried_chain, 0);
    let alice_i4 = image_at(curried_chain, 4);
    let ([ah1, ah2], alice_boost) = deal_hole_cards(alice_pre, bob_i4);
    let alice_opens = wins_opening_toss(alice_i4, bob_i4);
    [
        ["deal", ah1, ah2, alice_boost, alice_opens],
        nil,
        curry_program(spacepoker_alice_begin_round, [curried_chain, bet_unit]),
        alice_i4,
    ]
}

// my-turn: Alice opens a betting round (or pongs at N=4 if the coin toss
// says the waiter opens). state =
// (bet_unit half_pot mover_image_next waiter_image_n N mid_hash)
// local_move = raise amount (in mojos). When pong'ing, local_move is
// ignored.
export fn spacepoker_alice_begin_round(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    local_move: Int,
    amount: Int,
    state: Open,
    _mover_share: Int,
    _entropy: Bytes,
) -> MyTurnResult {
    let [(_, (half_pot, _)), waiter_image_n, round, ..._mid_hash] = state;
    let image_n = image_at(curried_chain, round);
    let mover_opens = mover_opens_round(round, image_n, waiter_image_n);
    if mover_opens {
        let raise_amount = local_move;
        let move_bytes = image_n + (raise_amount as Bytes);
        let new_mover_share = (amount / 2) - half_pot;
        [
            "spacepoker_alice_begin_round",
            move_bytes,
            new_mover_share,
            curry_program(
                spacepoker_alice_handler_mid_round_their,
                [curried_chain, curried_bet_unit],
            ),
        ]
    } else {
        let new_mover_share = (amount / 2) - half_pot;
        [
            "spacepoker_alice_begin_round pong",
            image_n,
            new_mover_share,
            curry_program(
                spacepoker_alice_handler_begin_round_their,
                [curried_chain, curried_bet_unit],
            ),
        ]
    }
}

// their-turn: Alice receives Bob's mid_round response (raise or call)
export fn spacepoker_alice_handler_mid_round_their(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    _amount: Int,
    pre_state: Raise,
    _state: Raise | Open | End,
    move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    if move.length <= 32 {
        let [(_, (half_pot, last_raise)), _, _, ...round] = pre_state;
        let new_half_pot = half_pot + last_raise;
        let readable = if round == 1 {
            let alice_pre = image_at(curried_chain, 0);
            let bob_pre = move;
            let { hands: { alice_cards, bob_cards }, alice_boost, bob_boost } = make_all_cards(
                alice_pre,
                bob_pre,
            );
            let (alice_hand, (alice_bitfield, _)) = space_hand_calc(alice_cards, alice_boost);
            let (bob_hand, (bob_bitfield, _)) = space_hand_calc(bob_cards, bob_boost);
            let alice_selected = pull_from_bitfield(alice_cards, alice_bitfield);
            let bob_selected = pull_from_bitfield(bob_cards, bob_bitfield);
            let result = deep_compare(alice_hand, bob_hand);
            [
                "call",
                new_half_pot,
                round,
                alice_cards,
                alice_boost,
                bob_cards,
                bob_boost,
                alice_selected,
                alice_hand,
                bob_selected,
                bob_hand,
                result,
            ]
        } else {
            let new_cards = community_cards_for_pos(
                image_at(curried_chain, round - 1),
                move,
                round - 1,
            );
            ["call", new_half_pot, round, ...new_cards]
        };
        if round == 1 {
            [readable, nil, curry_program(spacepoker_alice_handler_end, [curried_chain])]
        } else {
            [
                readable,
                nil,
                curry_program(spacepoker_alice_begin_round, [curried_chain, curried_bet_unit]),
                image_at(curried_chain, round - 1),
            ]
        }
    } else {
        let [(_bet_unit, (_half_pot, _last_raise)), _mover, _waiter, ..._round] = pre_state;
        let new_raise = move[32..move.length];
        [
            ["raise", new_raise, _half_pot + _last_raise],
            nil,
            curry_program(spacepoker_alice_mid_round, [curried_chain, curried_bet_unit]),
        ]
    }
}

// my-turn: Alice responds to a raise (raise or call)
// state = (bet_unit half_pot last_raise_amount mover_image_n waiter_image_n N)
// local_move = raise amount (nil to call)
export fn spacepoker_alice_mid_round(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    local_move: Int,
    amount: Int,
    state: Raise,
    _mover_share: Int,
    entropy: Bytes,
) -> MyTurnResult {
    let [(_, (half_pot, last_raise)), _, _, ...round] = state;
    if local_move != 0 {
        let raise_amount = local_move;
        let padding = entropy[0..32];
        let move_bytes = padding + (raise_amount as Bytes);
        let new_mover_share = (amount / 2) - (half_pot + last_raise);
        [
            "spacepoker_alice_mid_round raise",
            move_bytes,
            new_mover_share,
            curry_program(
                spacepoker_alice_handler_mid_round_their,
                [curried_chain, curried_bet_unit],
            ),
        ]
    } else {
        let preimage = image_at(curried_chain, round - 1);
        let new_mover_share = (amount / 2) - (half_pot + last_raise);
        let next_handler = if round == 1 {
            curry_program(spacepoker_alice_handler_end_their, [curried_chain])
        } else {
            curry_program(
                spacepoker_alice_handler_begin_round_their,
                [curried_chain, curried_bet_unit],
            )
        };
        let parser = if round == 1 {
            nil
        } else {
            [curry_program(parse_open_message, [curried_chain])]
        };
        ["spacepoker_alice_mid_round call", preimage, new_mover_share, next_handler, ...parser]
    }
}

// their-turn: Alice receives Bob's begin_round opening
// At N<4 the open reveals a preimage so we derive community cards for the
// readable (authoritative — works on-chain) and send the raw preimage as a
// message so the opener's side can pre-reveal the cards.
export fn spacepoker_alice_handler_begin_round_their(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    _amount: Int,
    pre_state: Open,
    _state: Open | Raise,
    move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    let [(_bet_unit, (_half_pot, _mover_next)), _, round, ..._mid_hash] = pre_state;
    let mover_image_n = move[0..32];
    let raise_amount = move[32..move.length];
    let readable = if round == 4 {
        ["open", raise_amount, _half_pot]
    } else {
        let new_cards = community_cards_for_pos(
            image_at(curried_chain, round),
            mover_image_n,
            round,
        );
        ["open", raise_amount, _half_pot, ...new_cards]
    };
    [readable, nil, curry_program(spacepoker_alice_mid_round, [curried_chain, curried_bet_unit])]
}

// my-turn: Alice makes final reveal at end
// state = (space-end)
// local_move = card selection bitfield (1 byte)
export fn spacepoker_alice_handler_end(
    curried_chain: List<Bytes>,
    _local_move: Any,
    amount: Int,
    state: End,
    _mover_share: Int,
    _entropy: Bytes,
) -> MyTurnResult {
    let pre = image_at(curried_chain, 0);
    let (half_pot, (_, waiter_preimage)) = state;
    let { hands: { alice_cards, bob_cards }, alice_boost, bob_boost } = make_all_cards(
        pre,
        waiter_preimage,
    );
    let (alice_hand, (alice_bitfield, _)) = space_hand_calc(alice_cards, alice_boost);
    let (bob_hand, _) = space_hand_calc(bob_cards, bob_boost);
    let move_bytes = pre + (alice_bitfield as Bytes);
    let final_mover_share = showdown_mover_share(amount, half_pot, alice_hand, bob_hand);
    ["spacepoker_alice_end", move_bytes, final_mover_share, 0]
}

// their-turn: Alice receives Bob's final reveal
// Returns evidence = Alice's best card selection bitfield for slash checking
export fn spacepoker_alice_handler_end_their(
    curried_chain: List<Bytes>,
    _amount: Int,
    _pre_state: End,
    _state: 0,
    move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    let alice_pre = image_at(curried_chain, 0);
    let bob_preimage = move[0..16];
    let {
        hands: { alice_cards: bob_cards, bob_cards: alice_cards },
        alice_boost: bob_boost,
        bob_boost: alice_boost,
    } = make_all_cards(bob_preimage, alice_pre);
    let (alice_hand, (alice_bitfield, _)) = space_hand_calc(alice_cards, alice_boost);
    let (bob_hand, (bob_bitfield, _)) = space_hand_calc(bob_cards, bob_boost);
    let alice_selected = pull_from_bitfield(alice_cards, alice_bitfield);
    let bob_selected = pull_from_bitfield(bob_cards, bob_bitfield);
    let result = deep_compare(alice_hand, bob_hand);
    [
        [
            "end",
            alice_selected,
            alice_hand,
            bob_selected,
            bob_hand,
            result,
            bob_cards.first,
            bob_cards.rest.first,
            bob_boost,
        ],
        [alice_bitfield],
        0,
    ]
}

// ─── Bob handlers (responder, goes second) ───────────────────────────
// their-turn: Bob receives Alice's commitA
export fn spacepoker_bob_handler_commitA(
    _amount: Int,
    _pre_state: Int,
    _state: Commit,
    _move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    [0, nil, spacepoker_bob_commitB]
}

// message parser for Bob: receives alice_i4 and derives Bob's hole cards.
// (message state amount) where message = alice_i4.
// state = (bet_unit half_pot alice_i5 bob_i4 N mid_hash).
// The "deal" readable's 5th element is the coin toss outcome from Bob's
// perspective: 1 if Bob opens (Alice ponged), 0 if Alice opens. Identical
// semantics to Alice's "deal" -- the recipient learns whether they open.
export fn spacepoker_bob_parse_deal_message(
    curried_chain: List<Bytes>,
    message: Bytes,
    state: Open,
    _amount: Int,
) -> [String, Int, Int, Bool, Bool] {
    let [(_bet_unit, (_half_pot, alice_i5)), _bob_i4, _N, ..._mid_hash] = state;
    let alice_i4 = message;
    assert sha256(alice_i4) == alice_i5;
    let bob_pre = image_at(curried_chain, 0);
    let bob_i4 = image_at(curried_chain, 4);
    let ([bh1, bh2], bob_boost) = deal_hole_cards(bob_pre, alice_i4);
    let alice_opens = wins_opening_toss(alice_i4, bob_i4);
    let bob_opens = !alice_opens;
    ["deal", bh1, bh2, bob_boost, bob_opens]
}

// my-turn: Bob commits his hash-chain tip
// state = (space-commit bet_unit alice_image_5)
export fn spacepoker_bob_commitB(
    _local_move: Any,
    amount: Int,
    state: Commit,
    _mover_share: Int,
    entropy: Bytes,
) -> MyTurnResult {
    let pre = entropy[0..16];
    let chain = build_image_chain(pre);
    let image_4 = image_at(chain, 4);
    let (bet_unit, _) = state;
    [
        "spacepoker_bob_commitB",
        image_4,
        (amount / 2) - bet_unit,
        curry_program(spacepoker_bob_handler_begin_round_their, [chain, bet_unit]),
        curry_program(spacepoker_bob_parse_deal_message, [chain]),
    ]
}

// their-turn: Bob receives Alice's begin_round move (open or, at N=4,
// possibly a pong). pre_state = begin_round input =
// (bet_unit half_pot mover_image_next waiter_image_n N mid_hash)
export fn spacepoker_bob_handler_begin_round_their(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    _amount: Int,
    pre_state: Open,
    _state: Open | Raise,
    move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    let [(_bet_unit, (_half_pot, _mover_next)), waiter_image_n, round, ..._mid_hash] = pre_state;
    let mover_image_n = move[0..32];
    let raise_amount = move[32..move.length];
    let mover_opens = mover_opens_round(round, mover_image_n, waiter_image_n);
    if mover_opens {
        let readable = if round == 4 {
            let bob_pre = image_at(curried_chain, 0);
            let ([bh1, bh2], bob_boost) = deal_hole_cards(bob_pre, mover_image_n);
            ["open", raise_amount, _half_pot, bh1, bh2, bob_boost]
        } else {
            let new_cards = community_cards_for_pos(
                image_at(curried_chain, round),
                mover_image_n,
                round,
            );
            ["open", raise_amount, _half_pot, ...new_cards]
        };
        [readable, nil, curry_program(spacepoker_bob_mid_round, [curried_chain, curried_bet_unit])]
    } else {
        let bob_pre = image_at(curried_chain, 0);
        let ([bh1, bh2], bob_boost) = deal_hole_cards(bob_pre, mover_image_n);
        [
            ["pong", bh1, bh2, bob_boost],
            nil,
            curry_program(spacepoker_bob_begin_round, [curried_chain, curried_bet_unit]),
        ]
    }
}

// my-turn: Bob responds to a raise (raise or call)
// state = (bet_unit half_pot last_raise_amount mover_image_n waiter_image_n N)
// local_move = raise amount (nil to call)
export fn spacepoker_bob_mid_round(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    local_move: Int,
    amount: Int,
    state: Raise,
    _mover_share: Int,
    entropy: Bytes,
) -> MyTurnResult {
    let [(_, (half_pot, last_raise)), _, _, ...round] = state;
    if local_move != 0 {
        let raise_amount = local_move;
        let padding = entropy[0..32];
        let move_bytes = padding + (raise_amount as Bytes);
        let new_mover_share = (amount / 2) - (half_pot + last_raise);
        [
            "spacepoker_bob_mid_round raise",
            move_bytes,
            new_mover_share,
            curry_program(
                spacepoker_bob_handler_mid_round_their,
                [curried_chain, curried_bet_unit],
            ),
        ]
    } else {
        let preimage = image_at(curried_chain, round - 1);
        let new_mover_share = (amount / 2) - (half_pot + last_raise);
        let next_handler = if round == 1 {
            curry_program(spacepoker_bob_handler_end_their, [curried_chain])
        } else {
            curry_program(
                spacepoker_bob_handler_begin_round_their,
                [curried_chain, curried_bet_unit],
            )
        };
        let parser = if round == 1 {
            nil
        } else {
            [curry_program(parse_open_message, [curried_chain])]
        };
        ["spacepoker_bob_mid_round call", preimage, new_mover_share, next_handler, ...parser]
    }
}

// their-turn: Bob receives Alice's mid_round response
export fn spacepoker_bob_handler_mid_round_their(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    _amount: Int,
    pre_state: Raise,
    _state: Raise | Open | End,
    move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    if move.length <= 32 {
        let [(_, (half_pot, last_raise)), _, _, ...round] = pre_state;
        let new_half_pot = half_pot + last_raise;
        let readable = if round == 1 {
            let bob_pre = image_at(curried_chain, 0);
            let alice_pre = move;
            let { hands: { alice_cards, bob_cards }, alice_boost, bob_boost } = make_all_cards(
                alice_pre,
                bob_pre,
            );
            let (bob_hand, (bob_bitfield, _)) = space_hand_calc(bob_cards, bob_boost);
            let (alice_hand, (alice_bitfield, _)) = space_hand_calc(alice_cards, alice_boost);
            let bob_selected = pull_from_bitfield(bob_cards, bob_bitfield);
            let alice_selected = pull_from_bitfield(alice_cards, alice_bitfield);
            let result = deep_compare(bob_hand, alice_hand);
            [
                "call",
                new_half_pot,
                round,
                bob_cards,
                bob_boost,
                alice_cards,
                alice_boost,
                bob_selected,
                bob_hand,
                alice_selected,
                alice_hand,
                result,
            ]
        } else {
            let new_cards = community_cards_for_pos(
                move,
                image_at(curried_chain, round - 1),
                round - 1,
            );
            ["call", new_half_pot, round, ...new_cards]
        };
        if round == 1 {
            [readable, nil, curry_program(spacepoker_bob_handler_end, [curried_chain])]
        } else {
            [
                readable,
                nil,
                curry_program(spacepoker_bob_begin_round, [curried_chain, curried_bet_unit]),
                image_at(curried_chain, round - 1),
            ]
        }
    } else {
        let [(_bet_unit, (_half_pot, _last_raise)), _mover, _waiter, ..._round] = pre_state;
        let new_raise = move[32..move.length];
        [
            ["raise", new_raise, _half_pot + _last_raise],
            nil,
            curry_program(spacepoker_bob_mid_round, [curried_chain, curried_bet_unit]),
        ]
    }
}

// my-turn: Bob opens a betting round. Called at N<4 in the normal flow,
// and at N=4 only when Alice ponged (in which case the coin toss is
// guaranteed to be flipped so Bob opens). The coin toss check is kept
// for symmetry with Alice's begin_round; if it ever says pong here it
// emits a pong move, matching the validator.
export fn spacepoker_bob_begin_round(
    curried_chain: List<Bytes>,
    curried_bet_unit: Int,
    local_move: Int,
    amount: Int,
    state: Open,
    _mover_share: Int,
    _entropy: Bytes,
) -> MyTurnResult {
    let [(_, (half_pot, _)), waiter_image_n, round, ..._mid_hash] = state;
    let image_n = image_at(curried_chain, round);
    let mover_opens = mover_opens_round(round, image_n, waiter_image_n);
    if mover_opens {
        let raise_amount = local_move;
        let move_bytes = image_n + (raise_amount as Bytes);
        let new_mover_share = (amount / 2) - half_pot;
        [
            "spacepoker_bob_begin_round",
            move_bytes,
            new_mover_share,
            curry_program(
                spacepoker_bob_handler_mid_round_their,
                [curried_chain, curried_bet_unit],
            ),
        ]
    } else {
        let new_mover_share = (amount / 2) - half_pot;
        [
            "spacepoker_bob_begin_round pong",
            image_n,
            new_mover_share,
            curry_program(
                spacepoker_bob_handler_begin_round_their,
                [curried_chain, curried_bet_unit],
            ),
        ]
    }
}

// my-turn: Bob makes final reveal at end
// state = (space-end)
// local_move = card selection bitfield (1 byte)
export fn spacepoker_bob_handler_end(
    curried_chain: List<Bytes>,
    _local_move: Any,
    amount: Int,
    state: End,
    _mover_share: Int,
    _entropy: Bytes,
) -> MyTurnResult {
    let pre = image_at(curried_chain, 0);
    let (half_pot, (_, waiter_preimage)) = state;
    let {
        hands: { alice_cards: mover_cards, bob_cards: waiter_cards },
        alice_boost: mover_boost,
        bob_boost: waiter_boost,
    } = make_all_cards(pre, waiter_preimage);
    let (mover_hand, (mover_bitfield, _)) = space_hand_calc(mover_cards, mover_boost);
    let (waiter_hand, _) = space_hand_calc(waiter_cards, waiter_boost);
    let move_bytes = pre + (mover_bitfield as Bytes);
    let final_mover_share = showdown_mover_share(amount, half_pot, mover_hand, waiter_hand);
    ["spacepoker_bob_end", move_bytes, final_mover_share, 0]
}

// their-turn: Bob receives Alice's final reveal
// Returns evidence = Bob's best card selection bitfield for slash checking
export fn spacepoker_bob_handler_end_their(
    curried_chain: List<Bytes>,
    _amount: Int,
    _pre_state: End,
    _state: 0,
    move: Bytes,
    _validation_info_hash: Bytes,
    _mover_share: Int,
) -> TheirTurnResult {
    let bob_pre = image_at(curried_chain, 0);
    let alice_preimage = move[0..16];
    let { hands: { alice_cards, bob_cards }, alice_boost, bob_boost } = make_all_cards(
        alice_preimage,
        bob_pre,
    );
    let (bob_hand, (bob_bitfield, _)) = space_hand_calc(bob_cards, bob_boost);
    let (alice_hand, (alice_bitfield, _)) = space_hand_calc(alice_cards, alice_boost);
    let bob_selected = pull_from_bitfield(bob_cards, bob_bitfield);
    let alice_selected = pull_from_bitfield(alice_cards, alice_bitfield);
    let result = deep_compare(bob_hand, alice_hand);
    [
        [
            "end",
            bob_selected,
            bob_hand,
            alice_selected,
            alice_hand,
            result,
            alice_cards.first,
            alice_cards.rest.first,
            alice_boost,
        ],
        [bob_bitfield],
        0,
    ]
}
