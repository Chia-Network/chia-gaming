(import std.shapes)

; Fixed records shared by on-chain validators and their callers.

(defun-shape space-commit #(bet_unit alice_image))
(defun-inline make-space-commit (bet_unit alice_image)
    (make (space-commit)))

(defun-shape space-open #(bet_unit half_pot mover_image waiter_image round mid_hash))
(defun-inline make-space-open (bet_unit half_pot mover_image waiter_image round mid_hash)
    (make (space-open)))

(defun-shape space-raise #(bet_unit half_pot last_raise mover_image waiter_image round))
(defun-inline make-space-raise (bet_unit half_pot last_raise mover_image waiter_image round)
    (make (space-raise)))

(defun-shape space-end #(half_pot mover_image waiter_preimage))
(defun-inline make-space-end (half_pot mover_image waiter_preimage)
    (make (space-end)))

(defun-shape space-cards #(alice_cards bob_cards alice_boost bob_boost))
(defun-inline make-space-cards (alice_cards bob_cards alice_boost bob_boost)
    (make (space-cards)))
