import krunk_payout::krunk_payout_share;

export fn expand_clue(clue: Bytes) -> List<Int> {
    reverse(expand_clue_inner((clue as Int) + 128, 5))
}

fn expand_clue_inner(value: Int, count: Int) -> List<Int> {
    if count == 0 {
        nil
    } else {
        [value % 3, ...expand_clue_inner(value / 3, count - 1)]
    }
}

export fn krunk_should_reveal(guess: Bytes, word: Bytes, num_guesses: Int) -> Bool {
    guess == word || num_guesses == 5
}

export fn krunk_reveal_mover_share(base_unit: Int, bob_guesses: List<Bytes>, word: Bytes) -> Int {
    assert bob_guesses is (Bytes, List<Bytes>);
    let guesses = length(bob_guesses);
    if bob_guesses.first == word {
        krunk_payout_share(base_unit, guesses)
    } else if guesses == 5 {
        0
    } else {
        raise ["krunk_reveal_mover_share: not terminal"];
    }
}
