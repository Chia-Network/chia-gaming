import krunk_dict_tree::Dictionary;
import krunk_generate::{FactoryArgs, GameRecord, krunk_factory};

import handler_types::FactoryResult;

fn main(
    dict_key: PublicKey,
    dict_tree: Dictionary,
    ...args: FactoryArgs,
) -> FactoryResult<GameRecord> {
    krunk_factory(dict_key, dict_tree, ...args)
}
