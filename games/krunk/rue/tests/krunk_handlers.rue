import artifacts::{krunk_clue_hash, krunk_commit_hash, krunk_factory_program};
import factory_record::first_record;

test fn factory_threads_clue_hash_and_commits_a_dictionary_word() {
    let word = "apple";
    let tree = [nil, nil, word];
    let record = first_record(krunk_factory_program(...["key", tree, 100, 100, 100]));
    assert record.validation_programs is (Any, List<Any>);
    assert tree_hash(record.validation_programs.first) == krunk_commit_hash;
    assert deep_equal(record.initial_state, ("key", (1, krunk_clue_hash)));
    let entropy = sha256("krunk");
    let reply = record.my_turn_handler(word, 100, record.initial_state, 0, entropy);
    assert !(reply is [String, Bytes]);
    let [label, move, share, _, ...parser] = reply;
    assert parser is [Any];
    assert label == "krunk_alice_handler_commit";
    assert move == sha256(entropy[..16] + word) && share == 0;
}
