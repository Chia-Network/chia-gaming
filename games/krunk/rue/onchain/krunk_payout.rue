const KRUNK_PAYOUTS: List<Int> = [100, 100, 20, 5, 1];

export fn krunk_payout_share(base_unit: Int, n: Int) -> Int {
    base_unit * item_at(KRUNK_PAYOUTS, n - 1)
}

export fn item_at<T>(items: List<T>, index: Int) -> T {
    assert items is (T, List<T>);
    if index == 0 {
        items.first
    } else {
        item_at(items.rest, index - 1)
    }
}
