import krunk_shapes::*;
import shapes::*;

// Alice challenging Bob's guess.
// state is (krunk-state)
// MOVE is Bob's 5-letter guess.
// evidence is a 10-byte atom (begin_range || end_range) when Alice slashes
// an out-of-dictionary guess. A condition (AGG_SIG_UNSAFE dict_pubkey evidence)
// is emitted to prove the range was signed by both players.
fn main(
    _mod_hash: Bytes32,
    params: RefereeParams,
    witness: Witness<State, Bytes>,
    ..._unused_payout: Any,
) -> ValidatorResult<State> {
    let { move_data: { move }, mover_share } = params;
    let (state, (_, evidence)) = witness;
    if (move.length == 5) && (mover_share == 0) {
        validator_result(
            state.clue_hash,
            State {
                ...state,
                guesses: GuessState {
                    ...state.guesses,
                    bob_guesses: (move, state.guesses.bob_guesses),
                },
            },
            21,
            if evidence is nil {
                nil
            } else {
                assert (move as Int) >= (evidence[0..5] as Int);
                assert (move as Int) <= (evidence[5..10] as Int);
                [[AGG_SIG_UNSAFE, state.guesses.dict_pubkey, evidence]]
            },
        )
    } else {
        0
    }
}
