// Fixed records use the balanced pair layout shared by validators and handlers.
export type Initial = (Any, (Any, Any));
export type Green = (Any, (Any, Any));

export struct State {
    guesses: GuessState,
    alice_clues: Any,
    alice_commit: Any,
    ...clue_hash: Any,
}

export struct GuessState {
    dict_pubkey: Any,
    base_unit: Any,
    ...bob_guesses: Any,
}

export inline fn make_krunk_initial(dict_pubkey: Any, base_unit: Any, clue_hash: Any) -> Initial {
    (dict_pubkey, (base_unit, clue_hash))
}

export inline fn make_krunk_green(remaining_word: Any, remaining_guess: Any, green: Any) -> Green {
    (remaining_word, (remaining_guess, green))
}
