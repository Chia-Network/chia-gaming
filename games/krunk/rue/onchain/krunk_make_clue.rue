import krunk_shapes::*;

inline const GRAY: Int = 0;
inline const YELLOW: Int = 1;
inline const GREEN: Int = 2;
export inline const ALL_GREEN_CLUE: Int = const { make_clue("GREEN", "GREEN") as Int };

export fn make_clue(word: Bytes, guess: Bytes) -> Bytes {
    let (remaining_word, (remaining_guess, green)) = make_green(
        expand_word(word),
        expand_word(guess),
    );
    let yellow = make_yellow(remaining_word, remaining_guess);
    let clue = merge_colors(green, yellow, 0) - 128;
    inline if clue == 0 { 0x00 } else { clue as Bytes }
}

fn expand_word(word: Bytes) -> List<Bytes> {
    [word[0..1], word[1..2], word[2..3], word[3..4], word[4..5]]
}

fn make_green(word: List<Bytes>, guess: List<Bytes>) -> Green {
    if word is nil {
        return make_krunk_green(nil, nil, nil);
    }
    assert guess is (Bytes, List<Bytes>);
    let (remaining_word, (remaining_guess, green)) = make_green(word.rest, guess.rest);
    if word.first == guess.first {
        make_krunk_green(remaining_word, remaining_guess, [true, ...green])
    } else {
        make_krunk_green(
            [word.first, ...remaining_word],
            [guess.first, ...remaining_guess],
            [false, ...green],
        )
    }
}

fn make_yellow(word: List<Bytes>, guess: List<Bytes>) -> List<Int> {
    if guess is nil {
        nil
    } else if contains(word, guess.first) {
        [YELLOW, ...make_yellow(elide_one(word, guess.first), guess.rest)]
    } else {
        [GRAY, ...make_yellow(word, guess.rest)]
    }
}

fn elide_one(word: List<Bytes>, letter: Bytes) -> List<Bytes> {
    assert word is (Bytes, List<Bytes>);
    if word.first == letter {
        word.rest
    } else {
        [word.first, ...elide_one(word.rest, letter)]
    }
}

fn merge_colors(green: List<Bool>, yellow: List<Int>, value: Int) -> Int {
    if green is nil {
        value
    } else if green.first {
        merge_colors(green.rest, yellow, 3 * value + GREEN)
    } else {
        assert yellow is (Int, List<Int>);
        merge_colors(green.rest, yellow.rest, 3 * value + yellow.first)
    }
}
