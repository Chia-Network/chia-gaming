import artifacts::{krunk_guess_hash};
import krunk_shapes::*;
import shapes::*;

// Bob challenging Alice's commit.
// previous_state is (krunk-initial).
// MOVE is sha256(salt || word), 32 bytes.
//
// The factory supplies clue_hash from its registered program. Thread it
// through state so transitions name that exact program instead of a separate
// nested compilation of clue.clsp.
fn main(
    _mod_hash: Any,
    params: RefereeParams,
    witness: Witness<Initial>,
    ..._unused_payout: Any,
) -> Any {
    let { move_data: { move }, mover_share } = params;
    let ((dict_pubkey, (base_unit, clue_hash)), _) = witness;
    if (move.length == 32) && (mover_share == 0) {
        validator_transition(
            krunk_guess_hash,
            State {
                guesses: GuessState { dict_pubkey, base_unit, bob_guesses: nil },
                alice_clues: nil,
                alice_commit: move,
                clue_hash,
            },
            5,
        )
    } else {
        0
    }
}
