(include *standard-cl-26*)
(import std.shapes)
(import games.krunk.clsp.shapes)
(import referee.shapes)

(import std.if_any_fail)
(import std.assert)
(import std.and)
(import std.relops)
(import std.li)
(import std.condition_codes)

; Alice challenging Bob's guess.
; state is (krunk-state)
; MOVE is Bob's 5-letter guess.
; evidence is a 10-byte atom (begin_range || end_range) when Alice slashes
; an out-of-dictionary guess. A condition (AGG_SIG_UNSAFE dict_pubkey evidence)
; is emitted to prove the range was signed by both players.
(export (referee-validator-args mod_hash
    #(MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
       MOVE MAX_MOVE_SIZE VALIDATION_INFO_HASH MOVER_SHARE PREVIOUS_VALIDATION_INFO_HASH)
    (krunk-state) previous_validation_program evidence unused_payout)

    (if_any_fail
        (= (strlen MOVE) 5)
        (= MOVER_SHARE 0)
        0
        (validator-result clue_hash (make-krunk-state dict_pubkey base_unit (c MOVE bob_guesses) alice_clues alice_commit clue_hash) 21 (if (not evidence) 0
                (assert
                    (>= MOVE (substr evidence 0 5))
                    (<= MOVE (substr evidence 5 10))
                    (li (li AGG_SIG_UNSAFE dict_pubkey evidence))
                )
            ))
    )
)
