(include *standard-cl-23*)
(import referee.shapes)

(import games.krunk.clsp.onchain.guess exposing (program_hash as guess_hash))
(import std.if_any_fail)
(import std.and)
(import std.li)

; Bob challenging Alice's commit.
; previous_state is (dict_pubkey base_unit clue_hash).
; MOVE is sha256(salt || word), 32 bytes.
;
; The factory supplies clue_hash from its registered program. Thread it
; through state so transitions name that exact program instead of a separate
; nested compilation of clue.clsp.
(export (referee-validator-args mod_hash
    #(MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
       MOVE MAX_MOVE_SIZE VALIDATION_INFO_HASH MOVER_SHARE PREVIOUS_VALIDATION_INFO_HASH)
    (dict_pubkey base_unit clue_hash) previous_validation_program evidence unused_payout)

    (if_any_fail
        (= (strlen MOVE) 32)
        (= MOVER_SHARE 0)
        0
        (list guess_hash (li dict_pubkey base_unit 0 0 MOVE clue_hash) 5)
    )
)
