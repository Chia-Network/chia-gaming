(include *standard-cl-23*)

(import games.krunk.clsp.onchain.guess exposing (program_hash as guess_hash))
(import games.krunk.clsp.onchain.krunk_make_clue exposing make_clue)
(import std.if_any_fail)
(import std.and)
(import std.relops)
(import std.li)
(import std.len)
(import std.condition_codes)

(defconst KRUNK_PAYOUTS (li 100 100 20 5 1))

(defun krunk_payout_share (base_unit n)
    (* base_unit (f (drop (- n 1) KRUNK_PAYOUTS)))
)

(defun drop (n lst)
    (if (= n 0)
        lst
        (drop (- n 1) (r lst))
    )
)

(defun reveal_mover_share (base_unit bob_guesses revealed_word)
    (if (= (len bob_guesses) 5)
        (if (= (f bob_guesses) revealed_word)
            (krunk_payout_share base_unit 5)
            0
        )
        (krunk_payout_share base_unit (len bob_guesses))
    )
)

; Bob challenging Alice's clue or reveal.
; state is (dict_pubkey base_unit bob_guesses alice_clues alice_commit clue_hash)
; MOVE is either a 1-byte clue or a 21-byte salt||word reveal.
; On a continue (clue), we transition back to guess. guess_hash is imported
; directly from games.krunk.clsp.onchain.guess.
(export (mod_hash
    (MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
        MOVE MAX_MOVE_SIZE VALIDATION_INFO_HASH MOVER_SHARE PREVIOUS_VALIDATION_INFO_HASH)
    (dict_pubkey base_unit bob_guesses alice_clues alice_commit clue_hash)
    previous_validation_program evidence)

    (if (= (strlen MOVE) 1)
        ; Alice gave a clue for Bob's latest guess.
        (if_any_fail
            (= MOVER_SHARE 0)
            (< (len alice_clues) 4)
            (> 0x72 MOVE)
            0
            (list guess_hash
                (li dict_pubkey base_unit bob_guesses (c MOVE alice_clues) alice_commit clue_hash)
                5)
        )
        ; Alice revealed salt||word.
        (if (= (strlen MOVE) 21)
            (assign
                revealed_word (substr MOVE 16 21)
                valid_terminal (list 0 0 0)
                (if_any_fail
                    (= MOVER_SHARE (reveal_mover_share base_unit bob_guesses revealed_word))
                    (= alice_commit (sha256 (substr MOVE 0 16) revealed_word))
                    0
                    (if (l evidence)
                        valid_terminal
                        (if (= (strlen evidence) 1)
                            ; Slash only when the selected prior clue is wrong.
                            ; At reveal time bob_guesses has one extra latest
                            ; guess with no clue, so the lists are offset by one.
                            (if (>= evidence 0)
                                (if (< evidence (len alice_clues))
                                    (if (= (make_clue revealed_word
                                                (f (drop (+ evidence 1) bob_guesses)))
                                            (f (drop evidence alice_clues)))
                                        valid_terminal
                                        0
                                    )
                                    valid_terminal
                                )
                                valid_terminal
                            )
                            (if (= (strlen evidence) 10)
                                ; A signed dictionary-gap range containing the
                                ; word authorizes this conditional slash.
                                (if (>= revealed_word (substr evidence 0 5))
                                    (if (<= revealed_word (substr evidence 5 10))
                                        (list 0 0 0
                                            (list AGG_SIG_UNSAFE dict_pubkey evidence))
                                        valid_terminal
                                    )
                                    valid_terminal
                                )
                                valid_terminal
                            )
                        )
                    )
                )
            )
            0
        )
    )
)
