(include *standard-cl-23*)
(import std.shapes)
(import games.calpoker.clsp.shapes)
(import referee.shapes)

(import games.calpoker.clsp.onchain.b exposing (program_hash as bhash))
(import games.game_codes)
(import std.assert)
(import std.and)
(import std.if_any_fail)

; Bob runs this program to determine the next state, and to validate the previous state
; state is empty
; move is alice commit to a salted word
; evidence is empty
; previous_validation_program below is the object whose hash is mod_hash
(export (referee-validator-args mod_hash
    #(MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
       MOVE MAX_MOVE_SIZE VALIDATION_INFO_HASH MOVER_SHARE PREVIOUS_VALIDATION_INFO_HASH)
    previous_state previous_validation_program evidence unused_payout)

    ;; First their turn for the second player
    (if (= (strlen MOVE) 32)
        (validator-transition bhash MOVE 16)
        0
    )
)
