import artifacts::{
    calpoker_a_program,
    calpoker_b_program,
    calpoker_c_program,
    calpoker_d_program,
    calpoker_e_program,
};
import calpoker_arrange_cards::*;
import calpoker_handcalc::*;
import calpoker_make_cards::*;
import calpoker_onehandcalc::*;
import calpoker_shapes::{Deal, DiscardState, Seeds};
import curry::curry_program;
import handler_types::{FactoryRecord, FactoryResult, MyTurnResult, OpeningHandler, TheirTurnResult};
import std_deep_compare::*;
import std_list_compare::*;
import std_popcount::*;

// Acceptance factory arguments: (proposer_reserve accepter_reserve requested_stake).
// Returns `(1 records)` or `(0 proposer_short accepter_short)`.
export type GameRecord = FactoryRecord<0, Int, OpeningHandler<0>>;
export type FactoryArgs = [Int, Int, Int, ...Any];

export fn calpoker_factory(...args: FactoryArgs) -> FactoryResult<GameRecord> {
    let [proposer_reserve, accepter_reserve, requested_stake, ..._] = args;
    assert requested_stake > 0;
    assert deep_eq(args, [proposer_reserve, accepter_reserve, requested_stake]);
    if (requested_stake > proposer_reserve) || (requested_stake > accepter_reserve) {
        [0, requested_stake > proposer_reserve, requested_stake > accepter_reserve]
    } else {
        [
            1,
            [GameRecord {
                proposer_contribution: requested_stake,
                accepter_contribution: requested_stake,
                proposer_goes_first: true,
                initial_move: nil,
                initial_max_move_size: 32,
                initial_state: 0,
                initial_mover_share: 0,
                my_turn_handler: calpoker_alice_handler_a,
                their_turn_handler: calpoker_bob_handler_a,
                validation_programs: [
                    calpoker_a_program,
                    calpoker_b_program,
                    calpoker_c_program,
                    calpoker_d_program,
                    calpoker_e_program,
                ],
                readable_parameters: requested_stake,
            }],
        ]
    }
}

// state is empty
// local_move is nil
export fn calpoker_alice_handler_a(
    _local_move: Any,
    _amount: Int,
    _state: 0,
    _split: Int,
    entropy: Bytes,
) -> MyTurnResult {
    let preimage = entropy[0..16];
    [
        "calpoker_alice_handler_a",
        sha256(preimage),
        0,
        curry_program(calpoker_alice_handler_b, [preimage]),
    ]
}

// pre_state is alice_commit
// move is Bob's seed
// state is (calpoker-seeds alice_commit bob_seed)
// immediately sends a message giving Alice's seed
export fn calpoker_alice_handler_b(
    curried_preimage: Bytes,
    amount: Int,
    _pre_state: Bytes,
    _state: Seeds,
    move: Bytes,
    _validation_info_hash: Bytes,
    _split: Int,
) -> TheirTurnResult {
    [
        {
            let (alice_cards, bob_cards) = make_cards(sha256(
                curried_preimage + move + (amount as Bytes),
            ));
            [alice_cards, bob_cards]
        },
        nil,
        curry_program(calpoker_alice_handler_c, [curried_preimage]),
        curried_preimage,
    ]
}

export fn single_byte(raw_indices: Int) -> Bytes {
    if raw_indices != 0 {
        let indices_len = (raw_indices as Bytes).length;
        (raw_indices as Bytes)[indices_len - 1..indices_len]
    } else {
        0x00
    }
}

export fn indices_to_bitfield_inner(mylist: List<Int>, index: Int) -> Int {
    if mylist is nil {
        0
    } else if mylist.first == index {
        1 | (indices_to_bitfield_inner(mylist.rest, index + 1) >>> -1)
    } else {
        indices_to_bitfield_inner(mylist, index + 1) >>> -1
    }
}

export fn indices_to_bitfield(mylist: List<Int>) -> Bytes {
    single_byte(indices_to_bitfield_inner(mylist, 0))
}

export fn list_contains(item: Int, mylist: List<Int>) -> Bool {
    if mylist is nil {
        false
    } else if item == mylist.first {
        true
    } else {
        list_contains(item, mylist.rest)
    }
}

export fn cards_to_indices_inner(cards: List<Int>, selected: List<Int>, index: Int) -> List<Int> {
    if cards is nil {
        nil
    } else if list_contains(cards.first, selected) {
        (index, cards_to_indices_inner(cards.rest, selected, index + 1))
    } else {
        cards_to_indices_inner(cards.rest, selected, index + 1)
    }
}

export fn cards_to_bitfield(selected: List<Int>, cards: List<Int>) -> Bytes {
    indices_to_bitfield(cards_to_indices_inner(cards, selected, 0))
}

// my_discards is a list of cards
// state is (calpoker-seeds alice_commit bob_seed)
// move is Alice's reveal of her card generating seed and her commit to which cards she's picking
export fn calpoker_alice_handler_c(
    curried_preimage: Bytes,
    my_discards: List<Int>,
    amount: Int,
    state: Seeds,
    _split: Int,
    entropy: Bytes,
) -> MyTurnResult {
    let (_, bob_seed) = state;
    let (cardsa, _) = make_cards(sha256(curried_preimage + bob_seed + (amount as Bytes)));
    let my_discards_bitfield = cards_to_bitfield(my_discards, cardsa);
    let salt = entropy[0..16];
    let new_commit = sha256(salt + my_discards_bitfield);
    if popcount(my_discards_bitfield as Int) == 4 {
        [
            "calpoker_alice_handler_c",
            curried_preimage + new_commit,
            0,
            curry_program(calpoker_alice_handler_d, [salt, my_discards_bitfield]),
        ]
    } else {
        raise [[
            "alice_handler_c bad discard selection",
            "bitfield",
            my_discards_bitfield,
            "popcount",
            popcount(my_discards_bitfield as Int),
        ]];
    }
}

// pre_state is (alce_cards bob_cards alice_commit)
// move is Bob's discards
// state is (calpoker-discard-state bob_discards alice_cards bob_cards alice_commit)
// should get an immediate call back with a nil move
export fn calpoker_alice_handler_d(
    my_salt: Bytes,
    my_picks: Bytes,
    amount: Int,
    _pre_state: Deal,
    record_arg4: DiscardState,
    move: Bytes,
    _validation_program_hash: Bytes,
    _split: Int,
) -> TheirTurnResult {
    let ((_, alice_cards), (bob_cards, _)) = record_arg4;
    let (my_all_cards_indices, bob_all_cards_indices) = get_final_cards_in_canonical_order(
        alice_cards,
        my_picks,
        bob_cards,
        move,
    );
    let my_all_cards = my_all_cards_indices;
    let bob_all_cards = bob_all_cards_indices;
    let (my_hand_value, (my_selects, _)) = handcalc(my_all_cards);
    let (bob_hand_value, (bob_selects, _)) = handcalc(bob_all_cards);
    let my_selects_bitfield = indices_to_bitfield(my_selects);
    let bob_selects_bitfield = indices_to_bitfield(bob_selects);
    let win_result = list_compare(my_hand_value, bob_hand_value);
    let split = (1 - win_result) * (amount / 2);
    [
        [
            move,
            my_selects_bitfield,
            bob_selects_bitfield,
            my_hand_value,
            bob_hand_value,
            win_result,
        ],
        nil,
        curry_program(calpoker_alice_handler_e, [my_salt + my_picks + my_selects_bitfield, split]),
    ]
}

// state is (alice_discards alice_card_selections alice_cards bob_cards alice_final_cards bob_final_cards)
// Alice makes a nil move to end the game
export fn calpoker_alice_handler_e(
    next_move: Bytes,
    curried_split: Int,
    _local_move: Any,
    _amount: Int,
    _state: DiscardState,
    _last_mover_share: Int,
    _entropy: Bytes,
) -> MyTurnResult {
    ["calpoker_alice_handler_e", next_move, curried_split, 0]
}

// pre_state is nil
// move is Alice commit
// state is alice_commit
export fn calpoker_bob_handler_a(
    _amount: Int,
    _pre_state: 0,
    _state: Bytes,
    _move: Bytes,
    _validation_program_hash: Bytes,
    _split: Int,
) -> TheirTurnResult {
    [0, nil, calpoker_bob_handler_b]
}

// local_move is nil
// state is alice_commit
// move is bob_seed
export fn calpoker_bob_handler_b(
    _local_move: Any,
    _amount: Int,
    _state: Bytes,
    _split: Int,
    entropy: Bytes,
) -> MyTurnResult {
    ["calpoker_bob_handler_b", entropy[0..16], 0, calpoker_bob_handler_c, parse_message]
}

// returns (alice_cards_readable bob_cards_readable)
export fn parse_message(message: Bytes, record_arg1: Seeds, amount: Int) -> [List<Int>, List<Int>] {
    let (alice_commit, bob_seed) = record_arg1;
    assert sha256(message) == alice_commit;
    let (alice_cards, bob_cards) = make_cards(sha256(
        message[0..16] + bob_seed[0..16] + (amount as Bytes),
    ));
    [alice_cards, bob_cards]
}

// state is alice's commit and bob's seed
// move is alice's reveal of her card generating seed and her commit to which cards she's picking
// expecting a message revealing Alice's seed which results in local display once verified
// return readable is (alice_cards bob_cards)
export fn calpoker_bob_handler_c(
    _amount: Int,
    _pre_state: Seeds,
    record_arg2: Deal,
    _move: Bytes,
    _validation_program_hash: Bytes,
    _split: Int,
) -> TheirTurnResult {
    let (_, (alice_cards, bob_cards)) = record_arg2;
    [[alice_cards, bob_cards], nil, calpoker_bob_handler_d]
}

// my_move is a list of cards
// state is (calpoker-deal alice_commit alice_cards bob_cards)
// move is Bob's discards
export fn calpoker_bob_handler_d(
    my_move: List<Int>,
    _amount: Int,
    state: Deal,
    _split: Int,
    _entropy: Bytes,
) -> MyTurnResult {
    let (_, (_, bob_cards)) = state;
    let my_discards_bitfield = cards_to_bitfield(my_move, bob_cards);
    [
        "calpoker_bob_handler_d",
        if popcount(my_discards_bitfield as Int) == 4 {
            my_discards_bitfield
        } else {
            raise [[
                "bob_handler_d bad discard selection",
                "bitfield",
                my_discards_bitfield,
                "popcount",
                popcount(my_discards_bitfield as Int),
            ]];
        },
        0,
        calpoker_bob_handler_e,
        0,
    ]
}

// pre_state is (calpoker-discard-state bob_discards alice_cards bob_cards alice_commit)
// move is alice_salted_discards (17 bytes) + alice_card_selections (1 byte)
// Computes final cards and hand values from pre_state + move.
// Nil-evidence e.clsp raises (evidence is required), so `state` is nil.
export fn calpoker_bob_handler_e(
    amount: Int,
    record_arg1: DiscardState,
    _state: 0,
    move: Bytes,
    _validation_program_hash: Bytes,
    split: Int,
) -> TheirTurnResult {
    let ((bob_discards, alice_cards), (bob_cards, _)) = record_arg1;
    let alice_discards = move[16..17];
    let alice_selects = move[17..move.length];
    let (alice_final_cards, bob_final_cards) = get_final_cards_in_canonical_order(
        alice_cards,
        alice_discards,
        bob_cards,
        bob_discards,
    );
    let alice_hand_value = onehandcalc(pull_out_cards(alice_selects as Int, alice_final_cards));
    let (bob_hand_value, (bob_selects, _)) = handcalc(bob_final_cards);
    [
        [
            alice_discards,
            alice_selects,
            indices_to_bitfield(bob_selects),
            alice_hand_value,
            bob_hand_value,
            deep_compare(split, amount / 2),
        ],
        [indices_to_bitfield(bob_selects)],
        0,
    ]
}
