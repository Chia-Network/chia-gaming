import calpoker_onehandcalc::*;
import common::*;
import std_deep_compare::*;
import std_max::*;

type Subset = [List<Int>, List<Int>, Int];

export fn process_entries(card: Int, index: Int, entries: List<Subset>) -> List<Subset> {
    if entries is nil {
        nil
    } else {
        let [sel_cards, sel_indices, count, ..._] = entries.first;
        let remaining = process_entries(card, index, entries.rest);
        let after_skip = if (count + index) > 4 {
            (entries.first, remaining)
        } else {
            remaining
        };
        if count < 5 {
            ([(card, sel_cards), (index, sel_indices), count + 1], after_skip)
        } else {
            after_skip
        }
    }
}

// Return all C(n, 5) subsets as (cards indices count) triples.
// Recurses on the tail first so prepending produces ascending indices.
export fn choose_hands(index: Int, cards: List<Int>) -> List<Subset> {
    if cards is nil {
        [[nil, nil, 0]]
    } else {
        process_entries(cards.first, index, choose_hands(index + 1, cards.rest))
    }
}

export fn handcalc(cards: List<Int>) -> [List<Int>, List<Int>] {
    maximum(
        deep_lt,
        map_with_rest(
            fn(subset: Subset) => {
                let [sel_cards, sel_indices, _] = subset;
                [onehandcalc(sel_cards), sel_indices]
            },
            choose_hands(0, cards),
            nil,
        ),
    )
}
