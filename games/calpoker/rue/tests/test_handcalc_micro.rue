import calpoker_arrange_cards::*;
import calpoker_handcalc::*;
import calpoker_make_cards::*;
import calpoker_onehandcalc::*;
import test_dispatch::apply_program;

fn main(kind: String, ...arguments: Any) -> Any {
    if kind == "onehandcalc" {
        apply_program(onehandcalc, [...arguments])
    } else if kind == "make_cards" {
        apply_program(make_cards, [...arguments])
    } else if kind == "pull_out_cards" {
        apply_program(pull_out_cards, [...arguments])
    } else if kind == "split_cards" {
        apply_program(split_cards, [...arguments])
    } else if kind == "get_final_cards_in_canonical_order" {
        apply_program(get_final_cards_in_canonical_order, [...arguments])
    } else if kind == "handcalc" {
        apply_program(handcalc, [...arguments])
    } else {
        raise ["Couldn't find entrypoint: ", kind];
    }
}
