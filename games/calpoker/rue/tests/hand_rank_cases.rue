// Compare the original rank/suit examples through the current mod-52 hand ABI.
import calpoker_handcalc::handcalc;
import calpoker_onehandcalc::onehandcalc;
import std_deep_compare::deep_compare;
import std_popcount::popcount;

fn nth(cards: List<Int>, index: Int) -> Int {
    assert cards is (Int, List<Int>);
    if index == 0 {
        cards.first
    } else {
        nth(cards.rest, index - 1)
    }
}

fn checked_rank(cards: List<Int>) -> List<Int> {
    let [rank, selected] = handcalc(cards);
    let mask = for index in selected fold mask = 0 { mask | (1 << index) };
    assert length(selected) == 5 && popcount(mask) == 5;
    let five = for index in selected { nth(cards, index) };
    assert deep_equal(rank, onehandcalc(five));
    rank
}

fn compare(left: List<(Int, Int)>, right: List<(Int, Int)>, expected: Int) {
    let a = for (rank, suit) in left { (rank - 2) * 4 + suit - 1 };
    let b = for (rank, suit) in right { (rank - 2) * 4 + suit - 1 };
    let first = checked_rank(a);
    let second = checked_rank(b);
    assert deep_equal(first, checked_rank(reverse(a)));
    assert deep_equal(second, checked_rank(reverse(b)));
    assert deep_compare(first, second) == expected;
}

test fn straight_flush_with_higher_kicker_ties() {
    compare(
        [(12, 1), (11, 1), (14, 1), (13, 1), (10, 1), (9, 1)],
        [(12, 1), (11, 1), (14, 1), (13, 1), (10, 1), (8, 1)],
        0,
    );
}

