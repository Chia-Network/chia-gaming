import calpoker_shapes::*;
import common::*;

export fn make_cards(randomness: Any) -> Any {
    let (handa, newrandomness) = unchecked_cast::<(Any, Any)>(choose(52, 8, randomness));
    let (handb, _) = unchecked_cast::<(Any, Any)>(choose(52 - 8, 8, newrandomness));
    make_calpoker_hands(handa, mergeover(handa, handb, 0))
}

// pick numchoose things out of numcards options with randomness extracted from vals
// returns (cards newvals) cards are always in sorted order
export fn choose(numcards: Any, numchoose: Any, randomness: Any) -> Any {
    if integer(numchoose) == 1 {
        let (newrandomness, card) = unchecked_cast::<(Any, Any)>(divmod(
            integer(randomness),
            integer(numcards),
        ));
        make_calpoker_draw([card], newrandomness)
    } else {
        let half = integer(numchoose) >>> 1;
        let (cards1, newrandomness2) = unchecked_cast::<(Any, Any)>(choose(
            numcards,
            half,
            randomness,
        ));
        let (cards2, newrandomness3) = unchecked_cast::<(Any, Any)>(choose(
            integer(numcards) - half,
            integer(numchoose) - half,
            newrandomness2,
        ));
        make_calpoker_draw(mergein(cards1, cards2, 0), newrandomness3)
    }
}

// like mergein but only calculates the contents of inner with offsets
// applied and doesn't interleave the contents of outer
export fn mergeover(outer: Any, inner: Any, offset: Any) -> Any {
    if !truthy(inner) {
        0
    } else {
        let first_item = integer(pair(inner).first) + integer(offset);
        if !truthy(outer) {
            (first_item, mergeover(0, pair(inner).rest, offset))
        } else if integer(pair(outer).first) <= first_item {
            mergeover(pair(outer).rest, inner, integer(offset) + 1)
        } else {
            (first_item, mergeover(outer, pair(inner).rest, offset))
        }
    }
}

// slide the things in inner in between the things in outer assuming
// things in inner are already bumped up by offset things from outer which
// came before
export fn mergein(outer: Any, inner: Any, offset: Any) -> Any {
    if !truthy(inner) {
        outer
    } else {
        let first_item = integer(pair(inner).first) + integer(offset);
        if !truthy(outer) {
            (first_item, mergein(0, pair(inner).rest, offset))
        } else if integer(pair(outer).first) <= first_item {
            (pair(outer).first, mergein(pair(outer).rest, inner, integer(offset) + 1))
        } else {
            (first_item, mergein(outer, pair(inner).rest, offset))
        }
    }
}
