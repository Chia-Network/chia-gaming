import calpoker_shapes::*;

export fn make_cards(randomness: Bytes) -> Hands {
    let (handa, newrandomness) = choose(52, 8, randomness as Int);
    let (handb, _) = choose(52 - 8, 8, newrandomness);
    make_calpoker_hands(handa, mergeover(handa, handb, 0))
}

// pick numchoose things out of numcards options with randomness extracted from vals
// returns (cards newvals) cards are always in sorted order
export fn choose(numcards: Int, numchoose: Int, randomness: Int) -> Draw {
    if numchoose == 1 {
        let (newrandomness, card) = divmod(randomness, numcards);
        make_calpoker_draw([card], newrandomness)
    } else {
        let half = numchoose >>> 1;
        let (cards1, newrandomness2) = choose(numcards, half, randomness);
        let (cards2, newrandomness3) = choose(numcards - half, numchoose - half, newrandomness2);
        make_calpoker_draw(mergein(cards1, cards2, 0), newrandomness3)
    }
}

// like mergein but only calculates the contents of inner with offsets
// applied and doesn't interleave the contents of outer
export fn mergeover(outer: List<Int>, inner: List<Int>, offset: Int) -> List<Int> {
    if inner is nil {
        nil
    } else {
        let first_item = inner.first + offset;
        if outer is nil {
            (first_item, mergeover(nil, inner.rest, offset))
        } else if outer.first <= first_item {
            mergeover(outer.rest, inner, offset + 1)
        } else {
            (first_item, mergeover(outer, inner.rest, offset))
        }
    }
}

// slide the things in inner in between the things in outer assuming
// things in inner are already bumped up by offset things from outer which
// came before
export fn mergein(outer: List<Int>, inner: List<Int>, offset: Int) -> List<Int> {
    if inner is nil {
        outer
    } else {
        let first_item = inner.first + offset;
        if outer is nil {
            (first_item, mergein(nil, inner.rest, offset))
        } else if outer.first <= first_item {
            (outer.first, mergein(outer.rest, inner, offset + 1))
        } else {
            (first_item, mergein(outer, inner.rest, offset))
        }
    }
}
