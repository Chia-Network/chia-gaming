import artifacts::{calpoker_e_hash};
import calpoker_shapes::*;
import common::*;
import shapes::*;
import std_popcount::*;

// Alice challenging
// state is the cards for both players and alice's card pick commitment
// MOVE is Bob's discards
// evidence is empty
fn main(_mod_hash: Any, params: Parameters, witness: Witness<Deal>, ..._unused_payout: Any) -> Any {
    let { move: bob_discards } = turn(params);
    let (state, _) = witness;
    let (alice_commit, (alice_cards, bob_cards)) = unchecked_cast::<(Any, (Any, Any))>(state);
    if (bytes(bob_discards).length == 1) && (integer(popcount(bob_discards)) == 4) {
        validator_transition(
            calpoker_e_hash,
            make_calpoker_discard_state(bob_discards, alice_cards, bob_cards, alice_commit),
            18,
        )
    } else {
        0
    }
}
