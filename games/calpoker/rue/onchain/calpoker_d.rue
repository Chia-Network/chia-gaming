import artifacts::{calpoker_e_hash};
import calpoker_shapes::*;
import shapes::*;
import std_popcount::*;

// Alice challenging
// state is the cards for both players and alice's card pick commitment
// MOVE is Bob's discards
// evidence is empty
fn main(
    _mod_hash: Bytes32,
    params: RefereeParams,
    witness: Witness<Deal, Any>,
    ..._unused_payout: Any,
) -> ValidatorResult<DiscardState> {
    let bob_discards = params.move_data.move;
    let ((alice_commit, (alice_cards, bob_cards)), _) = witness;
    if (bob_discards.length == 1) && (popcount(bob_discards as Int) == 4) {
        validator_transition(
            calpoker_e_hash,
            make_calpoker_discard_state(bob_discards, alice_cards, bob_cards, alice_commit),
            18,
        )
    } else {
        0
    }
}
