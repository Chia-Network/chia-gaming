import calpoker_arrange_cards::*;
import calpoker_onehandcalc::*;
import calpoker_shapes::DiscardState;
import common::*;
import shapes::*;
import std_list_compare::*;
import std_popcount::*;

// Terminal validator (on-chain only).
// state is (calpoker-discard-state bob_discards alice_cards bob_cards alice_commit)
// move is alice_salted_discards (17 bytes) and alice's card selections (1 byte)
// evidence is Bob's card selection bitfield (provided by slasher)
//
// Slash succeeds if Alice claimed more than her fair share given the
// best hand Bob can make with his evidence selections.
export fn does_alice_claim_small_enough(
    alice_hand_value: Any,
    bob_card_selections: Any,
    bob_final_cards: Any,
    mover_share: Any,
    amount: Any,
) -> Any {
    let bob_hand_value = onehandcalc(pull_out_cards(...[bob_card_selections, bob_final_cards]));
    let result = list_compare(alice_hand_value, bob_hand_value);
    integer(mover_share) >= integer(
        if !truthy(result) {
            integer(amount) / 2
        } else if integer(result) == 1 {
            0
        } else {
            amount
        },
    )
}

fn main(
    _mod_hash: Any,
    params: RefereeParams,
    witness: Witness<DiscardState>,
    ..._unused_payout: Any,
) -> Any {
    let {
        move_data: { move },
        coin: { amount: curried_amount },
        mover_share: curried_mover_share,
    } = params;
    let (
        ((bob_discards, alice_cards), (bob_cards, alice_commit)),
        (_, bob_card_selections),
    ) = witness;
    if (move.length != 18)
        || (integer(popcount(move[16..17])) != 4)
        || (integer(popcount(move[17..18])) != 5)
    {
        0
    } else {
        let alice_salted_discards = move[0..17];
        let alice_discards = move[16..17];
        let alice_card_selections = move[17..18];
        let (
            alice_final_cards,
            bob_final_cards,
        ) = unchecked_cast::<(Any, Any)>(get_final_cards_in_canonical_order(
            alice_cards,
            alice_discards,
            bob_cards,
            bob_discards,
        ));
        let alice_hand_value = onehandcalc(pull_out_cards(...[
            alice_card_selections,
            alice_final_cards,
        ]));
        if (sha256(alice_salted_discards) == bytes(alice_commit))
            && (
                !truthy(bob_card_selections)
                    || truthy({
                        assert bytes(bob_card_selections).length == 1;
                        does_alice_claim_small_enough(
                            alice_hand_value,
                            bob_card_selections,
                            bob_final_cards,
                            curried_mover_share,
                            curried_amount,
                        )
                    })
            )
        {
            validator_transition(0, 0, 0)
        } else {
            0
        }
    }
}
