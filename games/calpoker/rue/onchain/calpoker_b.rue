import artifacts::{calpoker_c_hash};
import calpoker_shapes::*;
import shapes::*;

// old_state is the initial state of ()
// move is bob_seed
// We receive alice's commit, producing a state consisting only of alice' commit.
// new state = sliace commit + bob_+seed
fn main(
    _mod_hash: Bytes32,
    params: RefereeParams,
    witness: Witness<Bytes, Any>,
    ..._unused_payout: Any,
) -> ValidatorResult {
    let move = params.move_data.move;
    let (alice_commit, _) = witness;
    if move.length == 16 {
        validator_transition(calpoker_c_hash, make_calpoker_seeds(alice_commit, move), 48)
    } else {
        0
    }
}
