ÿŽCHIALISP_DEBUGÿÿÿÿ€ÿ J á³ÇÉãˆ”…oU™9=û¡EöçÙ¹xÜ®¬*‰ÿÿÿ¦games/spacepoker/clsp/onchain/end.clspÿÓó(include *standard-cl-26*)
(import std.shapes)
(import games.spacepoker.clsp.onchain.shapes)
(import referee.onchain.shapes)

(import games.spacepoker.clsp.onchain.space_hand_eval exposing space_hand_eval)
(import std.and)
(import std.assert)
(import std.if_any_fail)
(import std.relops)
(import std.deep_compare)
(import std.popcount)
(import std.li)

; state is (space-end)
; MOVE is mover's preimage (16 bytes) concatenated with card selection bitfield (1 byte)
; evidence is waiter's card selection bitfield
(export (referee-validator-args mod_hash
    #(MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
       MOVE MAX_MOVE_SIZE VALIDATION_INFO_HASH MOVER_SHARE PREVIOUS_VALIDATION_INFO_HASH)
    (space-end) previous_validation_program evidence unused_payout)

    (if_any_fail
        (= (strlen MOVE) 17)
        (not VALIDATION_INFO_HASH)
        (= mover_image (sha256 (substr MOVE 0 16)))
        0
        (assign
            mover_bitfield (substr MOVE 16 17)
            (if_any_fail
                (not (logand mover_bitfield 0x80))
                (= (popcount mover_bitfield) 5)
                0
                ; Nil evidence inspects the transition without attempting
                ; a slash. Non-nil evidence is the waiter's selection.
                (if (not evidence)
                    (validator-transition 0 0 0)
                    (assign
                        (space-cards mover_cards waiter_cards mover_boost waiter_boost)
                            (make_all_cards (substr MOVE 0 16) waiter_preimage)
                        mover_selected (pull_from_bitfield mover_cards mover_bitfield)
                        (assert
                            (= (strlen evidence) 1)
                            (not (logand evidence 0x80))
                            (= (popcount evidence) 5)
                            (assign
                                waiter_selected (pull_from_bitfield waiter_cards evidence)
                                fair_share (assign result (deep_compare
                                        (space_hand_eval mover_selected mover_boost)
                                        (space_hand_eval waiter_selected waiter_boost))
                                    (if (not result)
                                        (/ AMOUNT 2)
                                        (= result 1)
                                        (- (/ AMOUNT 2) half_pot)
                                        (+ (/ AMOUNT 2) half_pot)
                                    )
                                )
                                ; The move creates a coin with roles swapped,
                                ; so MOVER_SHARE is the previous waiter's share.
                                (if (< MOVER_SHARE fair_share)
                                    0
                                    (validator-transition 0 0 0)
                                )
                            )
                        )
                    )
                )
            )
        )
    )
)

(defun pull_from_bitfield (cards bitfield)
    (if (not cards) 0
        (assign remaining (pull_from_bitfield (r cards) (lsh bitfield -1))
            (if (logand bitfield 1)
                (c (f cards) remaining)
                remaining
            )
        )
    )
)

; Community cards are revealed in the order: flop (3 cards from chain
; position 3, revealed first), turn (1 card from position 2), river (1
; card from position 1). The card list order here must match
; derive_all_cards in spacepoker_generate.clinc so the bitfield indexes
; the same cards on both sides.
(defun make_all_cards (alice_pre bob_pre)
    (assign
        alice_image_1 (sha256 alice_pre)
        alice_image_2 (sha256 alice_image_1)
        alice_image_3 (sha256 alice_image_2)
        alice_image_4 (sha256 alice_image_3)
        bob_image_1 (sha256 bob_pre)
        bob_image_2 (sha256 bob_image_1)
        bob_image_3 (sha256 bob_image_2)
        bob_image_4 (sha256 bob_image_3)
        (flop_1 flop_2 flop_3) (make_cards alice_image_3 bob_image_3 3)
        turn_card (f (make_cards alice_image_2 bob_image_2 1))
        river_card (f (make_cards alice_image_1 bob_image_1 1))
        (alice_hole_1 alice_hole_2) (make_cards alice_pre bob_image_4 2)
        (bob_hole_1 bob_hole_2) (make_cards bob_pre alice_image_4 2)
        alice_cards (li alice_hole_1 alice_hole_2 flop_1 flop_2 flop_3 turn_card river_card)
        bob_cards (li bob_hole_1 bob_hole_2 flop_1 flop_2 flop_3 turn_card river_card)
        alice_boost (not (% (sha256 (logxor alice_pre bob_image_4)) 3))
        bob_boost (not (% (sha256 (logxor bob_pre alice_image_4)) 3))
        (make-space-cards alice_cards bob_cards alice_boost bob_boost)
    )
)

(defun make_cards (thing1 thing2 num_cards)
    (extract_cards (sha256 (logxor thing1 thing2)) num_cards)
)

(defun extract_cards (value num_cards)
    (if (not num_cards)
        0
        (assign
            (nextval . next_card) (divmod value 13)
            (c (+ 2 next_card) (extract_cards nextval (- num_cards 1)))
        )
    )
)
€ÿÿ‡*prims*ÿ€€ÿÿµ./games/spacepoker/clsp/onchain/space_hand_eval.clincÿÇ 
; Space poker hand evaluator
;
; Cards are plain rank integers 2-14 (no suits, 14 = ace).
; No flushes, no ace-low straights.
;
; Hand representations (counts then ranks, boost inserted between):
;   5 of a kind:  (5 boost rank)
;   4 of a kind:  (4 1 boost quad_rank kicker)
;   straight:     (3 3 boost high_card)        -- beats full house (suitless: straights are rarer)
;   full house:   (3 2 boost set_rank pair_rank)
;   set:          (3 1 1 boost set_rank k1 k2)
;   two pair:     (2 2 1 boost hp lp k)
;   pair:         (2 1 1 1 boost pr k1 k2 k3)
;   high card:    (1 1 1 1 1 boost h k1 k2 k3 k4)

(import std.li)
(import std.map)
(import std.relops)
(import std.atomsort)

(defun group_by_count_inner (items last count)
    (if (not items)
        (list (+ (* 16 count) last))
        (if (= (f items) last)
            (group_by_count_inner (r items) last (+ count 1))
            (c (+ (* 16 count) last) (group_by_count_inner (r items) (f items) 1))
        )
    )
)

(defun group_by_count (items)
    (group_by_count_inner items (f items) 0)
)

; Evaluate a single 5-card hand. Returns (counts... boost ranks...).
; Modeled on calpoker's onehandcalc: map produces a flat hand with
; boost inserted between counts and ranks via map's tail argument.
(defun space_hand_eval (cards boost)
    (assign
        sorted (atomsort cards)
        raw_groups (atomsort (group_by_count sorted))
        (@ hand (first_count))
            (map (lambda (x) (lsh x -4)) raw_groups
                (c boost (map (lambda (x) (logand x 15)) raw_groups)))
        (if (not (= first_count 1))
            hand
            (assign
                (_ _ _ _ _ _ r1 _ _ _ r5) hand
                (if (= r5 (- r1 4))
                    (li 3 3 boost r1)
                    hand
                )
            )
        )
    )
)

