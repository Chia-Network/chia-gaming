)
€ÿÿ“clsp/std/sort.clincÿÄ(import std.prepend)
(import std.reverse)

(defun split_inner (@ everything (rest aggl aggr))
    (if rest
        (split_inner (r rest) aggr (c (f rest) aggl))
        (r everything)
    )
)

(defun split (mylist)
    (split_inner mylist 0 0)
)

(defun merge_inner (myless A B agg)
    ; this should use continued if
    (if (not A)
        (prepend (reverse agg) B)
        (if (not B)
            (prepend (reverse agg) A)
            (if (a myless (list (f A) (f B)))
                (merge_inner myless (r A) B (c (f A) agg))
                (merge_inner myless A (r B) (c (f B) agg))
            )
        )
    )
)

(defun merge (myless a b)
    (merge_inner myless a b 0)
)

(defun sort-split (myless (a b))
    (merge myless (sort myless a) (sort myless b))
)

(defun sort (myless mylist)
    (if mylist
        (if (r mylist)
            (assign (a b) (split mylist)
                sa (sort myless a)
                sb (sort myless b)
                (merge myless sa sb)
            )
            mylist
        )
        0
    )
)
€ÿÿ¡clsp/referee/onchain/shapes.clincÿÆ(import std.shapes)

; Keep the Rust encoders/decoder in src/referee/types.rs aligned with these.
(defun-shape referee-parameters
    #(MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
      MOVE MAX_MOVE_SIZE INFOHASH_B MOVER_SHARE INFOHASH_A))

(defun-shape referee-timeout
    ((atom mover_payout_ph) . (atom waiter_payout_ph)))

(defun-shape referee-move
    (((atom new_move) . (atom infohash_c)) . ((atom new_mover_share) . (atom new_max_move_size))))

; A pair on the left and an atom on the right distinguishes slash from both
; timeout (two atoms) and move (two pairs). Evidence contributes no constraints.
(defun-shape referee-slash
    ((previous_state previous_validation_program . (optional evidence)) . (atom mover_payout_ph)))

; Shared by on-chain validators and off-chain validation. Payout is unused by
; validators; off-chain calls supply nil there. No terminating list nils.
(defun-shape referee-validator-args
    (validator_hash curried_args (state validation_program . evidence) . payout))

; Non-nil validator result. The conditions tail is a variable-length list.
; Terminal success has nil hash/state and zero size; nil itself means slash.
(defun-shape referee-result
    ((next_validator_hash . new_state) . (max_move_size . extra_conditions)))
(defun-inline validator-result (next_validator_hash new_state max_move_size extra_conditions)
    (make (referee-result)))
(defun-inline validator-transition (next_validator_hash new_state max_move_size)
    (validator-result next_validator_hash new_state max_move_size ()))
