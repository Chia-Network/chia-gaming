€ÿÿ®./games/calpoker/clsp/onchain/make_cards.clincÿÈn(import std.shapes)
(import games.calpoker.clsp.onchain.shapes)
(import std.relops)

(defun make_cards (randomness)
    (assign
        (calpoker-draw handa newrandomness) (choose 52 8 randomness)
        (calpoker-draw handb newrandomness2) (choose (- 52 8) 8 newrandomness)
        (make-calpoker-hands handa (mergeover handa handb 0))
    )
)

; pick numchoose things out of numcards options with randomness extracted from vals
; returns (cards newvals) cards are always in sorted order
(defun choose (numcards numchoose randomness)
    (if (= numchoose 1)
        (assign (newrandomness . card) (divmod randomness numcards)
            (make-calpoker-draw (list card) newrandomness)
        )
        (assign 
            half (lsh numchoose -1)
            (calpoker-draw cards1 newrandomness2) (choose numcards half randomness)
            (calpoker-draw cards2 newrandomness3) (choose (- numcards half) (- numchoose half) newrandomness2)
            (make-calpoker-draw (mergein cards1 cards2 0) newrandomness3)
        )
    )
)

; like mergein but only calculates the contents of inner with offsets
; applied and doesn't interleave the contents of outer
(defun mergeover (outer inner offset)
    (if (not inner)
        0
        (assign first (+ (f inner) offset)
            (if (not outer)
                (c first (mergeover 0 (r inner) offset))
                (if (<= (f outer) first)
                    (mergeover (r outer) inner (+ offset 1))
                    (c first (mergeover outer (r inner) offset))
                )
            )
        )
    )
)

; slide the things in inner in between the things in outer assuming 
; things in inner are already bumped up by offset things from outer which 
; came before
(defun mergein (outer inner offset)
    (if (not inner)
        outer
        (assign first (+ (f inner) offset)
            (if (not outer)
                (c first (mergein 0 (r inner) offset))
                (if (<= (f outer) first)
                    (c (f outer) (mergein (r outer) inner (+ offset 1)))
                    (c first (mergein outer (r inner) offset))
                )
            )
        )
    )
)
€ÿÿ¯./games/calpoker/clsp/onchain/onehandcalc.clincÿË[; Evaluates the best poker hand from 5 cards in mod52 format (0-51).
; mod52 encoding: card_id = (rank - 2) * 4 + (suit - 1)
;
; Hands are represented:
; straight flush (5 high_card)
; 4 of a kind  (4 1 quad_rank kicker)
; full house (3 2 set_rank pair_rank)
; flush (3 1 3 high_card first_kicker second_kicker third_kicker fourth_kicker)
; straight (3 1 2 high_card)
; set (3 1 1 set_rank first_kicker second_kicker)
; two pair (2 2 1 high_pair_rank low_pair_rank kicker)
; pair (2 1 1 1 pair_rank first_kicker second_kicker third_kicker)
; high card (1 1 1 1 1 high_card first_kicker second_kicker third_kicker fourth_kicker)

(import std.li)
(import std.map)
(import std.relops)
(import std.isthere)
(import std.atomsort)
(import games.calpoker.clsp.onchain.flatten_card)

(defun mod52_to_pair (card_id)
    (assign
        (rank . suit) (divmod card_id 4)
        (c (+ 2 rank) (+ 1 suit))
    )
)

(defun check_flush (@ cards ((rank1 . suit1) (rank2 . suit2) (rank3 . suit3) (rank4 . suit4) (rank5 . suit5)))
    (logand (= suit1 suit2) (= suit1 suit3) (= suit1 suit4) (= suit1 suit5))
)

; returns the high card of a straight or 0 if there isn't any
(defun straight_high (@ all-args (count1 count2 count3 count4 count5 rank1 rank2 rank3 rank4 rank5))
    (if (not (= count1 1))
        0
        (= rank5 (- rank1 4))
        rank1
        (= rank1 14)
        (* (= rank2 5) 5)
        0
    )
)

(defun group_by_count_inner (items last count)
    (if (not items)
        (li (flatten_card (c count last)))
        (if (= (f items) last)
            (group_by_count_inner (r items) last (+ count 1))
            (c (flatten_card (c count last)) (group_by_count_inner (r items) (f items) 1))
        )
    )
)

(defun group_by_count (items)
    (group_by_count_inner items (f items) 0)
)

(defun onehandcalc (cards)
    (onehandcalc_inner (map mod52_to_pair cards))
)

(defun onehandcalc_inner ((@ cards ((card1rank . card1suit) (card2rank . card2suit) (card3rank . card3suit)
            (card4rank . card4suit) (card5rank . card5suit))))
    (assign-lambda
        ranks (atomsort (li card1rank card2rank card3rank card4rank card5rank))
        raw_groups (atomsort (group_by_count ranks))
        (@ hand (first_count second_count arg3 arg4 arg5 . flush_ranks))
            (map (lambda (x) (lsh x -4)) raw_groups (map (lambda (x) (logand x 15)) raw_groups))
        shigh (straight_high &rest hand)
        (if shigh
            (if (check_flush &rest cards)
                (li 5 shigh)
                (if (logior (= first_count 4) (logand (= first_count 3) (= second_count 2)))
                    hand
                    (li 3 1 2 shigh)
                )
            )
            (if (logand (check_flush &rest cards) (logior (< first_count 3) (logand (= first_count 3) (< second_count 2))))
                (li 3 1 3 &rest flush_ranks)
                hand
            )
        )
    )
)
