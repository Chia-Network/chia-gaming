€ÿÿ—clsp/std/atomsort.clincÿÅ6(import std.isthere)

(defun merge (a b)
    (if (not a)
        b
        (if (not b)
            a
            (if (> (f a) (f b))
                (c (f a) (merge (r a) b))
                (c (f b) (merge a (r b)))
            )
        )
    )
)

; Sorts atoms into descending order
; This is optimized for sorting short lists
; A more general function would return a list of lists of ascending sizes
; to be merged
(defun atomsort ((@ whole_list (first second third . remaining)))
    (if (not whole_list)
        0
        (not (isthere second))
        whole_list
        (not (isthere third))
        (if (> first second)
            whole_list
            (list second first)
        )
        (merge 
            (if (> first second)
                (if (> second third)
                    (list first second third)
                    (if (> first third)
                        (list first third second)
                        (list third first second)
                    )
                )
                (if (> first third)
                    (list second first third)
                    (if (> second third)
                        (list second third first)
                        (list third second first)
                    )
                )
            )
            (atomsort remaining)
        )
    )
)
€ÿÿ›clsp/std/deep_compare.clincÿÂÑ
(defun deep_compare (a b)
    (if (l a)
        (if (l b)
            (assign-lambda inner_result (deep_compare (f a) (f b))
                (if inner_result
                    inner_result
                    (deep_compare (r a) (r b))
                )
            )
            1
        )
        (if (l b)
            -1
            (if (> a b)
                1
                (- 0 (> b a))
            )
        )
    )
)

(defun deep< (a b)
    (= (deep_compare a b) -1)
)

(defun deep> (a b)
    (= (deep_compare a b) 1)
)

(defun deep= (a b)
    (= (deep_compare a b) 0)
)

(defun deep<= (a b)
    (not (deep> a b))
)

(defun deep>= (a b)
    (not (deep< a b))
)

(defun deep!= (a b)
    (not (deep= a b))
)
€ÿÿ’clsp/std/map.clincÿÂ\(defun map-with-rest (F L R)
    (if L
        (c (a F (list (f L))) (map-with-rest F (r L) R))
        R
    )
)

(defun list-len (X) (if X (+ 1 (list-len (r X))) 0))

(defmac map ARGS
    (if (= (list-len ARGS) 3)
        (qq (map-with-rest (unquote (f ARGS)) (unquote (f (r ARGS))) (unquote (f (r (r ARGS))))))
        (qq (map-with-rest (unquote (f ARGS)) (unquote (f (r ARGS))) 0))
    )
)

(defun map_enumerate_inner (idx F LST)
  (if LST
      (c (a F (list (f LST) idx)) (map_enumerate_inner (+ 1 idx) F (r LST)))
      ()
      )
  )

(defun map_enumerate (F LST) (map_enumerate_inner 0 F LST))
€ÿÿ’clsp/std/max.clincÿÁJ(defun max_inner (myless best_so_far mylist)
    (if (not mylist) best_so_far
        (if (a myless (list best_so_far (f mylist)))
            (max_inner myless (f mylist) (r mylist))
            (max_inner myless best_so_far (r mylist))
        )
    )
)
(defun max (myless mylist)
    (max_inner myless (f mylist) (r mylist))
)
