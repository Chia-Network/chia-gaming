)

(defun krunk_reveal_mover_share (base_unit bob_guesses word)
    (if (= (f bob_guesses) word)
        (krunk_payout_share base_unit (len bob_guesses))
        (if (= (len bob_guesses) 5)
            0
            (x "krunk_reveal_mover_share: not terminal")
        )
    )
)
