(import std.shapes)
(import games.krunk.clsp.onchain.shapes)
(import referee.onchain.shapes)

(import std.if_any_fail)
(import std.assert)
(import std.and)
(import std.relops)
(import std.li)
(import std.condition_codes)

; Alice challenging Bob's guess.
; state is (krunk-state)
; MOVE is Bob's 5-letter guess.
; evidence is a 10-byte atom (begin_range || end_range) when Alice slashes
; an out-of-dictionary guess. A condition (AGG_SIG_UNSAFE dict_pubkey evidence)
; is emitted to prove the range was signed by both players.
(export (referee-validator-args mod_hash
    #(MOVER_PUBKEY WAITER_PUBKEY TIMEOUT AMOUNT MOD_HASH NONCE
       MOVE MAX_MOVE_SIZE VALIDATION_INFO_HASH MOVER_SHARE PREVIOUS_VALIDATION_INFO_HASH)
    (krunk-state) previous_validation_program evidence unused_payout)

    (if_any_fail
        (= (strlen MOVE) 5)
        (= MOVER_SHARE 0)
        0
        (validator-result clue_hash (make-krunk-state dict_pubkey base_unit (c MOVE bob_guesses) alice_clues alice_commit clue_hash) 21 (if (not evidence) 0
                (assert
                    (>= MOVE (substr evidence 0 5))
                    (<= MOVE (substr evidence 5 10))
                    (li (li AGG_SIG_UNSAFE dict_pubkey evidence))
                )
            ))
    )
)
€ÿÿ°./games/krunk/clsp/onchain/krunk_make_clue.clincÿÆ (import std.shapes)
(import games.krunk.clsp.onchain.shapes)
(defun make_clue (word guess)
    (assign
        (krunk-green not_green_word not_green_guess green) (make_green (expand_word word) (expand_word guess))
        yellow (make_yellow not_green_word not_green_guess)
        (- (merge_colors green yellow 0) 128)
    )
)

(defun expand_word (word)
    (list (substr word 0 1) (substr word 1 2) (substr word 2 3) (substr word 3 4) (substr word 4 5))
)

(defun make_green (word guess)
    (if (not word)
        (make-krunk-green 0 0 0)
        (assign (krunk-green inner_not_green_word inner_not_green_guess inner_green) (make_green (r word) (r guess))
            (if (= (f word) (f guess))
                (make-krunk-green inner_not_green_word inner_not_green_guess (c 1 inner_green))
                (make-krunk-green (c (f word) inner_not_green_word) (c (f guess) inner_not_green_guess) (c 0 inner_green))
            )
        )
    )
)

(defun make_yellow (word guess)
    (if (not guess)
        0
        (if (is_yellow word (f guess))
            (c 1 (make_yellow (elide_one word (f guess)) (r guess)))
            (c 0 (make_yellow word (r guess)))
        )
    )
)

(defun elide_one (word letter)
    (if (= (f word) letter)
        (r word)
        (c (f word) (elide_one (r word) letter))
    )
)

(defun is_yellow (word letter)
    (if (not word)
        0
        (if (= (f word) letter)
            1
            (is_yellow (r word) letter)
        )
    )
)

(defun merge_colors (green yellow val)
    (if (not green)
        val
        (merge_colors (r green)
            (if (f green) yellow (r yellow))
            (+ (* 3 val) (if (f green) 2 (f yellow))))
    )
)
