ÿŽCHIALISP_DEBUGÿÿÿÿ€ÿ Ù²ªÅ¢Pðs°Éo¨¤¿U”þÕ•F*Äý®®bÂÏ6ÿÿÿ§./games/krunk/clsp/krunk_generate.clincÿÝ“(include *standard-cl-26*)
(import std.shapes)
(import games.krunk.clsp.onchain.shapes)

(import games.krunk.clsp.krunk_helpers exposing
    expand_clue
    krunk_should_reveal
    krunk_reveal_move
    krunk_reveal_mover_share
)
(import games.krunk.clsp.krunk_dict_tree)
(import games.krunk.clsp.onchain.krunk_make_clue exposing make_clue)
(import std.li)
(import std.shatree)
(import std.curry)
(import std.assert)
(import std.len)
(import std.deep_compare)
(import std.or)

; --- deterministic factory ---
;
; DICT_TREE and DICT_PUBKEY are curried in at startup from a single .dat file
; (48-byte BLS pubkey prefix + serialized CLVM tree).
; The on-chain initial state is (DICT_PUBKEY base_unit clue_hash); the full
; dictionary tree stays off-chain. Derive clue_hash from the registered
; validator so every transition names its exact compiled program.

(import games.krunk.clsp.onchain.commit exposing (program as val_commit))
(import games.krunk.clsp.onchain.guess exposing (program as val_guess))
(import games.krunk.clsp.onchain.clue exposing (program as val_clue))

(defconstant MIN_WORD 0x8000000000)
(defconstant MAX_WORD 0x7fffffffff)

(defun krunk_factory
    (DICT_PUBKEY DICT_TREE
     @ _args
     (proposer_reserve accepter_reserve requested_stake))
    (assert
        (> requested_stake 0)
        (= (% requested_stake 100) 0)
        (deep= _args (li proposer_reserve accepter_reserve requested_stake))
        (if (or (> requested_stake proposer_reserve) (> requested_stake accepter_reserve))
            (li 0 (> requested_stake proposer_reserve) (> requested_stake accepter_reserve))
            (assign
                base_unit (/ requested_stake 100)
                initial_state (make-krunk-initial DICT_PUBKEY base_unit (shatree val_clue))
                alice_handler (curry krunk_alice_handler_commit DICT_TREE)
                bob_handler (curry krunk_bob_handler_commit DICT_TREE)
                (li 1
                    (li
                        ; Slot 0 allocates the proposer's contribution.
                        (li
                            requested_stake 0 1 0 32 initial_state 0
                            alice_handler bob_handler (list val_commit val_guess val_clue)
                            requested_stake
                        )
                        ; Slot 1 allocates the accepter's contribution and swaps first role.
                        (li
                            0 requested_stake 0 0 32 initial_state 0
                            alice_handler bob_handler (list val_commit val_guess val_clue)
                            requested_stake
                        )
                    )
                )
            )
        )
    )
)

; --- Alice handlers ---

(defun krunk_alice_handler_commit (DICT_TREE local_move amount state mover_share entropy)
    (assign
        word local_move
        salt (substr entropy 0 16)
        move (sha256 salt word)
        (if (dict_lookup MIN_WORD MAX_WORD word DICT_TREE)
            (list "not_in_dictionary" word)
            (list
                "krunk_alice_handler_commit"
                move
                0
                (curry krunk_alice_handler_guess salt word DICT_TREE)
                0
            )
        )
    )
)

(defun krunk_alice_handler_guess (SALT WORD DICT_TREE amount pre_state state move validation_info_hash mover_share)
    (assign
        (krunk-state dict_pubkey base_unit bob_guesses alice_clues alice_commit _clue_hash) state
        lookup_result (dict_lookup MIN_WORD MAX_WORD move DICT_TREE)
        (if lookup_result
            (list 0
                (li (li "s"
                        (concat
                            (get-field (krunk-dictionary-gap) left_bound lookup_result)
                            (get-field (krunk-dictionary-gap) right_bound lookup_result))
                        (get-field (krunk-dictionary-gap) signature lookup_result)))
                0)
            (assign
                clue (make_clue WORD move)
                (list
                    (li move (expand_clue clue))
                    0
                    (curry krunk_alice_handler_clue SALT WORD clue DICT_TREE)
                )
            )
        )
    )
)

(defun krunk_alice_handler_clue (SALT WORD CLUE DICT_TREE local_move amount state mover_share entropy)
    (assign
        (krunk-state dict_pubkey base_unit bob_guesses alice_clues alice_commit _clue_hash) state
        num_guesses (len bob_guesses)
        latest_guess (f bob_guesses)
        (if (krunk_should_reveal latest_guess WORD num_guesses)
            (assign
                reveal (krunk_reveal_move SALT WORD)
                payout (krunk_reveal_mover_share base_unit bob_guesses WORD)
                (list
                    "krunk_alice_handler_clue reveal"
                    reveal
                    payout
                    0
                    0
                )
            )
            (list
                "krunk_alice_handler_clue"
                CLUE
                0
                (curry krunk_alice_handler_guess SALT WORD DICT_TREE)
                0
            )
        )
    )
)

; --- Bob handlers ---

(defun krunk_bob_handler_commit (DICT_TREE amount pre_state state move validation_info_hash mover_share)
    (list
        0
        0
        (curry krunk_bob_handler_guess DICT_TREE)
    )
)

(defun krunk_bob_handler_guess (DICT_TREE local_move amount state mover_share entropy)
    (assign
        (krunk-state dict_pubkey base_unit bob_guesses alice_clues alice_commit _clue_hash) state
        guess local_move
        (if (dict_lookup MIN_WORD MAX_WORD guess DICT_TREE)
            (list "not_in_dictionary" guess)
            (list
                "krunk_bob_handler_guess"
                guess
                0
                (curry krunk_bob_handler_clue DICT_TREE)
                0
            )
        )
    )
)

(defconst KRUNK_EVIDENCE_INDICES (li (q . 0x00) 1 2 3 4))

(defun krunk_bob_handler_clue (DICT_TREE amount pre_state state move validation_info_hash mover_share)
    (if (= (strlen move) 1)
        ; Non-terminal clue: state is valid.
        (assign
            (krunk-state dict_pubkey base_unit bob_guesses alice_clues alice_commit _clue_hash) state
            (list
                (expand_clue move)
                0
                (curry krunk_bob_handler_guess DICT_TREE)
            )
        )
        ; Terminal reveal: framework passes nil state, use pre_state.
        (assign
            (krunk-state dict_pubkey base_unit bob_guesses alice_clues alice_commit _clue_hash) pre_state
            word (substr move 16 21)
            reveal_clue (if mover_share
                (expand_clue 0x72)
                (expand_clue (make_clue word (f bob_guesses)))
            )
            lookup_result (dict_lookup MIN_WORD MAX_WORD word DICT_TREE)
            (if lookup_result
                (list
                    (li word reveal_clue)
                    (li (li "s"
                            (concat
                                (get-field (krunk-dictionary-gap) left_bound lookup_result)
                                (get-field (krunk-dictionary-gap) right_bound lookup_result))
                            (get-field (krunk-dictionary-gap) signature lookup_result)))
                    0
                    0
                )
                (list
                    (li word reveal_clue)
                    KRUNK_EVIDENCE_INDICES
                    0
                    0
                )
            )
        )
    )
)
