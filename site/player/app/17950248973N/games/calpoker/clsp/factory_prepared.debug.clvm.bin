(defun list_compare (a b)
    (if (= (f a) (f b))
        (if (r a)
            (list_compare (r a) (r b))
            0
        )
        (- (* 2 (> (f a) (f b))) 1)
    )
)

(defun list< (a b)
    (= (list_compare a b) -1)
)
